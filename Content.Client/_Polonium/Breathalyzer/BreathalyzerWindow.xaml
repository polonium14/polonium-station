<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:breathalyzer="clr-namespace:Content.Client._Polonium.Breathalyzer"
                      MinSize="330 300"
                      SetSize="330 300"
                      Resizable="False">
    <BoxContainer Orientation="Vertical" Margin="10">
        <PanelContainer Name="Display" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="12 8 12 10">
                <BoxContainer Orientation="Horizontal">
                    <Label Name="HeaderLabel" Text="{Loc 'breathalyzer-ui-header'}" HorizontalExpand="True" />
                    <Label Name="StateLabel" HorizontalAlignment="Right" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 6 0 0">
                    <Label Name="ValueLabel" />
                    <Label Name="UnitLabel" Text="‰" VerticalAlignment="Bottom" Margin="6 0 0 4" />
                </BoxContainer>
                <Label Name="StatusLabel" HorizontalAlignment="Center" Margin="0 4 0 8" />
                <breathalyzer:BreathalyzerGauge Name="Gauge" MinHeight="40" VerticalExpand="True" />
            </BoxContainer>
        </PanelContainer>
        <BoxContainer Orientation="Horizontal" Margin="0 6 0 0">
            <Label Name="FooterLabel" HorizontalExpand="True" ClipText="True" StyleClasses="LabelSubText" />
            <Button Name="PrintButton" Text="{Loc 'forensic-scanner-interface-print'}" Disabled="True" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
