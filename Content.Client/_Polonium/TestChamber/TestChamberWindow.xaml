<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'test-chamber-window-title'}"
                      MinSize="520 480">
    <BoxContainer Orientation="Vertical" Margin="8">
        <LineEdit Name="SearchBar" PlaceHolder="{Loc 'test-chamber-window-search'}" Margin="0 0 0 6"/>
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="KitList" Orientation="Vertical"/>
        </ScrollContainer>
        <PanelContainer StyleClasses="LowDivider" Margin="0 6 0 6"/>
        <RichTextLabel Name="DescriptionLabel" MinHeight="64"/>
        <BoxContainer Orientation="Horizontal" Margin="0 6 0 0">
            <Button Name="SpawnButton" Text="{Loc 'test-chamber-window-spawn'}" Disabled="True" MinWidth="150"/>
            <Control HorizontalExpand="True"/>
            <controls:ConfirmButton Name="ResetButton"
                                    Text="{Loc 'test-chamber-window-reset'}"
                                    ConfirmationText="{Loc 'test-chamber-window-reset-confirm'}"
                                    StyleClasses="Caution"
                                    MinWidth="150"/>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
