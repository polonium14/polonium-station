<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc 'horror-mutations-window-title'}"
    MinSize="460 360"
    SetSize="560 520">
    <BoxContainer Orientation="Vertical" Margin="8">
        <Label Name="PointsLabel" />
        <ScrollContainer HScrollEnabled="False" VerticalExpand="True" Margin="0 6 0 0">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                <Label Text="{Loc 'horror-mutations-window-abilities'}" StyleClasses="LabelHeading" />
                <BoxContainer Name="AbilityList" Orientation="Vertical" HorizontalExpand="True" />
                <Label Text="{Loc 'horror-mutations-window-upgrades'}" StyleClasses="LabelHeading" Margin="0 8 0 0" />
                <BoxContainer Name="UpgradeList" Orientation="Vertical" HorizontalExpand="True" />
            </BoxContainer>
        </ScrollContainer>
    </BoxContainer>
</controls:FancyWindow>
