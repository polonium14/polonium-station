<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'discord-link-window-title'}"
               SetWidth="460">
    <BoxContainer Orientation="Vertical">
        <BoxContainer Orientation="Horizontal" SeparationOverride="4">
            <Label HorizontalAlignment="Left" Name="UsernameField" Text="{Loc 'discord-link-uuid-label'}"/>
            <Label HorizontalAlignment="Left" Name="UUIDField"/>
        </BoxContainer>
        <BoxContainer Orientation="Horizontal" Margin="0 10 0 0">
            <Button HorizontalAlignment="Left"
                    VerticalExpand = "false"
                    Name="CopyUUID"
                    Text="{Loc 'discord-link-copy-uuid'}"/>
        </BoxContainer>
        <!-- DiscordLinkUIController puts the Discord link here -->
        <BoxContainer Access="Public" Name="DiscordLinkContainer" Orientation="Vertical"/>
    </BoxContainer>
</DefaultWindow>
