<PanelContainer
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Margin="2">
    <BoxContainer
        Orientation="Vertical"
        HorizontalExpand="True">
        <controls:Separator StyleClasses="LowDivider"/>
    </BoxContainer>
    <BoxContainer
        HorizontalAlignment="Stretch"
        Margin="0, 8, 0, 0">
        <Button
            Name="ButtonButton"
            Text="{Loc 'modsuit-interface-seal-all'}"
            HorizontalAlignment="Stretch"
            HorizontalExpand="True"
            TextAlign="Center"
            Access="Public"/>
    </BoxContainer>
</PanelContainer>
