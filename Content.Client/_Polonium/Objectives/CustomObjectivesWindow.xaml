<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'custom-objectives-window-title'}"
                      MinSize="520 520">
    <BoxContainer Orientation="Vertical" Margin="10">
        <Label Name="PlayerLabel" StyleClasses="LabelKeyText" />
        <Label Name="NoMindLabel"
               Text="{Loc 'custom-objectives-no-mind'}"
               FontColorOverride="#FF3333"
               Visible="False" />

        <ScrollContainer HScrollEnabled="False" VerticalExpand="True" MinHeight="180">
            <BoxContainer Name="ObjectivesContainer" Orientation="Vertical" />
        </ScrollContainer>
        <Label Name="EmptyLabel" Text="{Loc 'custom-objectives-empty'}" Visible="False" />

        <PanelContainer StyleClasses="LowDivider" MinSize="0 2" Margin="0 6" />

        <Label Text="{Loc 'custom-objectives-new'}" StyleClasses="LabelKeyText" />
        <LineEdit Name="TitleEdit" PlaceHolder="{Loc 'custom-objectives-title-placeholder'}" />
        <TextEdit Name="DescriptionEdit" MinHeight="90" />
        <Label Name="DescriptionLimitLabel" HorizontalAlignment="Right" StyleClasses="LabelSmall" />
        <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc 'custom-objectives-issuer'}" Margin="0 0 8 0" />
            <OptionButton Name="IssuerOptions" HorizontalExpand="True" />
        </BoxContainer>
        <Button Name="AddButton" Text="{Loc 'custom-objectives-add'}" Margin="0 6 0 0" />
    </BoxContainer>
</controls:FancyWindow>
