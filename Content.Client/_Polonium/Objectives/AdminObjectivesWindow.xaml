<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'admin-objectives-window-title'}"
                      MinSize="560 680">
    <BoxContainer Orientation="Vertical" Margin="10">
        <Label Name="PlayerLabel" StyleClasses="LabelKeyText" />
        <Label Name="NoMindLabel"
               Text="{Loc 'admin-objectives-no-mind'}"
               FontColorOverride="#FF3333"
               Visible="False" />

        <ScrollContainer HScrollEnabled="False" VerticalExpand="True" MinHeight="200">
            <BoxContainer Name="ObjectivesContainer" Orientation="Vertical" />
        </ScrollContainer>
        <Label Name="EmptyLabel" Text="{Loc 'admin-objectives-empty'}" Visible="False" />

        <PanelContainer StyleClasses="LowDivider" MinSize="0 2" Margin="0 6" />

        <TabContainer Name="AddTabs" MinHeight="300">
            <BoxContainer Orientation="Vertical"
                          Margin="6"
                          SeparationOverride="4"
                          TabContainer.TabTitle="{Loc 'admin-objectives-tab-standard'}">
                <BoxContainer Orientation="Horizontal">
                    <LineEdit Name="SearchEdit"
                              PlaceHolder="{Loc 'admin-objectives-search-placeholder'}"
                              HorizontalExpand="True"
                              Margin="0 0 6 0" />
                    <OptionButton Name="IssuerFilter" MinWidth="200" />
                </BoxContainer>
                <ItemList Name="PrototypeList" VerticalExpand="True" MinHeight="160" />
                <ScrollContainer Name="StandardErrorScroll"
                                 HScrollEnabled="False"
                                 MinHeight="48"
                                 Visible="False">
                    <RichTextLabel Name="StandardErrorLabel" />
                </ScrollContainer>
                <Button Name="AddStandardButton" Text="{Loc 'admin-objectives-add'}" />
            </BoxContainer>
            <BoxContainer Orientation="Vertical"
                          Margin="6"
                          SeparationOverride="4"
                          TabContainer.TabTitle="{Loc 'admin-objectives-tab-custom'}">
                <Label Text="{Loc 'admin-objectives-title'}" StyleClasses="LabelSubText" />
                <LineEdit Name="TitleEdit" PlaceHolder="{Loc 'admin-objectives-title-placeholder'}" />
                <BoxContainer Orientation="Horizontal">
                    <Label Text="{Loc 'admin-objectives-description'}"
                           StyleClasses="LabelSubText"
                           HorizontalExpand="True" />
                    <Label Name="DescriptionLimitLabel" StyleClasses="LabelSubText" />
                </BoxContainer>
                <PanelContainer StyleClasses="BackgroundDark" VerticalExpand="True">
                    <TextEdit Name="DescriptionEdit" MinHeight="80" Margin="4" />
                </PanelContainer>
                <BoxContainer Orientation="Horizontal" Margin="0 2 0 0">
                    <Label Text="{Loc 'admin-objectives-issuer'}" StyleClasses="LabelSubText" Margin="0 0 8 0" />
                    <OptionButton Name="IssuerOptions" HorizontalExpand="True" />
                </BoxContainer>
                <Button Name="AddCustomButton" Text="{Loc 'admin-objectives-add'}" />
            </BoxContainer>
        </TabContainer>
    </BoxContainer>
</controls:FancyWindow>
