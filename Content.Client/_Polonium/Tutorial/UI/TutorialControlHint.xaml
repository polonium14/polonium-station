<Control xmlns="https://spacestation14.io"
         xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
         MouseFilter="Ignore"
         Visible="False">
    <PanelContainer Name="HintPanel"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    MaxWidth="420"
                    MouseFilter="Ignore">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#0E1A1FEE" BorderColor="#65B8E2" BorderThickness="2" />
        </PanelContainer.PanelOverride>
        <BoxContainer Name="HintBox"
                      Orientation="Vertical"
                      Margin="18 10 18 10"
                      MouseFilter="Ignore">
            <RichTextLabel Name="ObjectiveLabel" />
            <RichTextLabel Name="DetailsLabel" Margin="0 6 0 0" Visible="False" />
            <Button Name="MoreButton"
                    StyleClasses="ButtonSquare"
                    HorizontalAlignment="Left"
                    Margin="0 8 0 0"
                    MinHeight="32"
                    MouseFilter="Stop"
                    Visible="False" />
            <PanelContainer Name="HintSeparator" MinSize="0 1" Margin="0 8 0 8" MouseFilter="Ignore">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#65B8E255" />
                </PanelContainer.PanelOverride>
            </PanelContainer>
            <RichTextLabel Name="HintLabel" />
        </BoxContainer>
    </PanelContainer>
</Control>
