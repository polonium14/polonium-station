<DefaultWindow xmlns="https://spacestation14.io"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Title="{Loc 'tutorial-anchor-labeler-ui-header'}"
            SetWidth="420"
            MinWidth="200">
    <BoxContainer Orientation="Vertical" SeparationOverride="4">
        <Label Name="CurrentTextLabel" Text="{Loc 'tutorial-anchor-labeler-current-text-label'}" />
        <LineEdit Name="LabelLineEdit" />
        <BoxContainer Orientation="Horizontal" Align="Center">
            <Button Name="ResetLabelButton" Text="{Loc 'tutorial-anchor-labeler-ui-reset-text'}" StyleClasses="OpenRight" />
            <Button Name="ClearLabelButton" Text="{Loc 'tutorial-anchor-labeler-ui-clear-text'}" StyleClasses="OpenLeft" />
        </BoxContainer>
        <Label Text="{Loc 'tutorial-anchor-labeler-hover-header'}" />
        <PanelContainer StyleClasses="AngleRect" MinHeight="96">
            <RichTextLabel Name="HoverLabel" HorizontalExpand="True" Margin="6" />
        </PanelContainer>
    </BoxContainer>
</DefaultWindow>
