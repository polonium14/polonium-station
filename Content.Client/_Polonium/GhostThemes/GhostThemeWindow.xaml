<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'ghost-theme-window-title'}"
                      MinSize="720 480"
                      SetSize="820 560">
    <BoxContainer Orientation="Horizontal" Margin="4" SeparationOverride="8">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4">
            <LineEdit Name="SearchBar" PlaceHolder="{Loc 'ghost-theme-window-search'}" />
            <TabContainer Name="Tabs" VerticalExpand="True" />
            <ScrollContainer Name="SearchResults" VerticalExpand="True" HScrollEnabled="False" Visible="False">
                <BoxContainer Name="SearchList" Orientation="Vertical" SeparationOverride="2" />
            </ScrollContainer>
        </BoxContainer>
        <PanelContainer StyleClasses="BackgroundPanelDark" MinWidth="280" MaxWidth="280">
            <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
                <SpriteView Name="Preview" Scale="4 4" OverrideDirection="South" SetSize="160 160" HorizontalAlignment="Center" />
                <Label Name="ThemeName" StyleClasses="LabelHeading" HorizontalAlignment="Center" />
                <RichTextLabel Name="ThemeDescription" />
                <BoxContainer Name="ColorBox" Orientation="Vertical" Visible="False">
                    <Label Text="{Loc 'ghost-theme-window-color'}" StyleClasses="LabelKeyText" />
                    <ColorSelectorSliders Name="ColorSliders" />
                </BoxContainer>
                <Control VerticalExpand="True" />
                <RichTextLabel Name="LockedReason" Visible="False" />
                <Button Name="ChooseButton" Text="{Loc 'ghost-theme-window-choose'}" StyleClasses="positive" />
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>
