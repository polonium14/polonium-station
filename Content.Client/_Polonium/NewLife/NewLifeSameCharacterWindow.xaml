<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      Title="{Loc 'new-life-same-character-title'}"
                      Resizable="False">
    <BoxContainer Orientation="Vertical" SetWidth="440">
        <controls:StripeBack>
            <Label Text="{Loc 'new-life-same-character-header'}"
                   StyleClasses="LabelHeading"
                   FontColorOverride="#A5762F"
                   HorizontalAlignment="Center"
                   Margin="0 4 0 4"/>
        </controls:StripeBack>

        <PanelContainer Margin="14 10 14 0">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1B1B1E" BorderColor="#A5762F" BorderThickness="1"/>
            </PanelContainer.PanelOverride>
            <RichTextLabel Name="WarningLabel" Margin="10 8 10 8"/>
        </PanelContainer>

        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="14 12 14 12">
            <Button Name="CancelButton"
                    Text="{Loc 'new-life-same-character-cancel'}"
                    MinWidth="150"/>
            <Control HorizontalExpand="True"/>
            <Button Name="ContinueButton"
                    Text="{Loc 'new-life-same-character-continue'}"
                    StyleClasses="Caution"
                    MinWidth="150"/>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
