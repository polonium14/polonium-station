<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      Title="{Loc 'new-life-window-title'}"
                      Resizable="False">
    <BoxContainer Orientation="Vertical" SetWidth="480">
        <RichTextLabel Name="IntroLabel" Margin="14 12 14 12"/>

        <controls:StripeBack>
            <Label Text="{Loc 'new-life-window-rules-title'}"
                   StyleClasses="LabelHeading"
                   HorizontalAlignment="Center"
                   Margin="0 4 0 4"/>
        </controls:StripeBack>

        <PanelContainer Margin="14 10 14 0">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1B1B1E" BorderColor="#3B3E56" BorderThickness="1"/>
            </PanelContainer.PanelOverride>
            <BoxContainer Name="RulesContainer" Orientation="Vertical" Margin="10 8 10 4"/>
        </PanelContainer>

        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="14 12 14 12">
            <Button Name="CancelButton"
                    Text="{Loc 'new-life-window-cancel'}"
                    MinWidth="150"/>
            <Control HorizontalExpand="True"/>
            <Button Name="ConfirmButton"
                    Text="{Loc 'new-life-window-confirm'}"
                    StyleClasses="Caution"
                    MinWidth="150"/>
        </BoxContainer>

        <PanelContainer StyleClasses="LowDivider"/>
        <Label Name="FooterLabel"
               StyleClasses="WindowFooterText"
               Margin="10 2 10 5"
               HorizontalAlignment="Left"/>
    </BoxContainer>
</controls:FancyWindow>
