<PanelContainer xmlns="https://spacestation14.io"
                xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                xmlns:ui="clr-namespace:Content.Client._DV.UserInterfaces"
                xmlns:xe="clr-namespace:Content.Client.UserInterface.XamlExtensions"
                StyleClasses="PanelLight"
                HorizontalExpand="True">
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="6 3">
        <Label Name="DocumentName"
               HorizontalExpand="True"
               ClipText="True"
               MouseFilter="Pass"
               VerticalAlignment="Center"
               Margin="2 0 8 0" />
        <ui:IconButton Name="OpenButton"
                       ToolTip="{Loc 'fax-machine-ui-open-document'}"
                       Icon="{xe:Tex '/Textures/_DV/Interface/Fax/eye.svg.192dpi.png'}"
                       StyleClasses="OpenRight" />
        <ui:IconButton Name="CopyButton"
                       ToolTip="{Loc 'fax-machine-ui-copy-button'}"
                       Icon="{xe:Tex '/Textures/_DV/Interface/Fax/files.svg.192dpi.png'}"
                       StyleClasses="OpenBoth" />
        <ui:IconButton Name="SendButton"
                       ToolTip="{Loc 'fax-machine-ui-send-button'}"
                       Icon="{xe:Tex '/Textures/_DV/Interface/Fax/send.svg.192dpi.png'}"
                       StyleClasses="OpenBoth" />
        <controls:ConfirmButton Name="ShredButton"
                                ToolTip="{Loc 'fax-machine-ui-shred-document'}"
                                ConfirmationText="{Loc 'fax-machine-ui-shred-confirm'}"
                                StyleClasses="OpenLeft">
            <TextureRect Name="ShredIcon"
                         Texture="{xe:Tex '/Textures/_DV/Interface/Fax/shredder.svg.192dpi.png'}"
                         TextureScale="0.5 0.5"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Stretch="KeepCentered" />
        </controls:ConfirmButton>
    </BoxContainer>
</PanelContainer>
