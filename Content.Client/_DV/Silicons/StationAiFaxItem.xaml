<PanelContainer xmlns="https://spacestation14.io"
                xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                StyleClasses="PanelLight"
                HorizontalExpand="True">
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="6 3">
        <Label Name="DocumentName"
               HorizontalExpand="True"
               ClipText="True"
               MouseFilter="Pass"
               VerticalAlignment="Center"
               Margin="2 0 8 0" />
        <Button Name="OpenButton" Text="{Loc 'fax-machine-ui-open-document'}" StyleClasses="OpenRight" />
        <Button Name="CopyButton" Text="{Loc 'fax-machine-ui-copy-button'}" StyleClasses="OpenBoth" />
        <Button Name="SendButton" Text="{Loc 'fax-machine-ui-send-button'}" StyleClasses="OpenBoth" />
        <controls:ConfirmButton Name="ShredButton"
                                Text="{Loc 'fax-machine-ui-shred-document'}"
                                ConfirmationText="{Loc 'fax-machine-ui-shred-confirm'}"
                                StyleClasses="OpenLeft" />
    </BoxContainer>
</PanelContainer>
