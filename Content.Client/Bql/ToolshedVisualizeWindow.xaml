<DefaultWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc 'ui-bql-results-title'}">
    <BoxContainer Orientation="Vertical" MinSize="500 700">
        <Label Name="StatusLabel" />
        <ScrollContainer VerticalExpand="True">
            <BoxContainer Orientation="Vertical" VerticalExpand="True">
                <BoxContainer Orientation="Horizontal" Name="HeaderRow" />
                <controls:Separator StyleClasses="LowDivider"/>
                <BoxContainer Orientation="Vertical" Name="ItemList" />
            </BoxContainer>
        </ScrollContainer>
    </BoxContainer>
</DefaultWindow>
