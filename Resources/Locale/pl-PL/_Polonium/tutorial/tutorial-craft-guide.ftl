# karta obok menu budowania, sala 16
tutorial-guide-done = { $step } - gotowe
tutorial-craft-guide-title = Menu budowania
tutorial-craft-guide-goal = Do zbudowania: { $name }.
tutorial-craft-guide-step-find = 1. Znajdź przepis
tutorial-craft-guide-step-find-body = Wpisz nazwę w pole wyszukiwania albo wybierz kategorię z listy obok. Potem kliknij przepis - po prawej zobaczysz, z czego się go buduje.
tutorial-craft-guide-step-build = 2. Włącz budowanie
tutorial-craft-guide-step-build-body = Kliknij przycisk na dole, pod listą kroków. Przy kursorze pojawi się zarys konstrukcji.
tutorial-craft-guide-step-place = 3. Postaw na znaczniku
tutorial-craft-guide-step-place-body = Kliknij w znacznik na podłodze. Zielony zarys to dopiero plan - stal dodasz za chwilę.
tutorial-craft-guide-status-search = Wpisz „{ $name }” w świecące pole wyszukiwania.
tutorial-craft-guide-status-pick = Kliknij świecący przepis na liście.
tutorial-craft-guide-status-build = Kliknij świecący przycisk budowania.
tutorial-craft-guide-status-place = Kliknij w znacznik. Żeby przerwać, kliknij przycisk budowania jeszcze raz.
tutorial-craft-guide-need-hand = Weź do ręki materiał, na przykład stal - z pustą ręką budowa nie ruszy.
tutorial-craft-guide-need-rotate = Terminal musi patrzeć na SMES. Obróć podgląd środkowym przyciskiem myszy, zanim klikniesz.
