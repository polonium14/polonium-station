ent-AbductorConsole = konsola statku
    .desc = Centrum dowodzenia statku. Pokazuje stan badań Wydziału Sondowania.
ent-AbductorHumanObservationConsole = konsola obserwacyjna
    .desc = Pokazuje stację oczami jej własnych kamer. Stąd steruje się telepadem.
ent-AbductorAlienPad = telepad
    .desc = Obcy teleporter. Kto na nim stoi, może zostać wysłany na stację.
ent-AbductorExperimentator = komora badawcza
    .desc = Odczytuje wyniki operacji i odsyła okaz na stację.
ent-AbductorOperatingTable = stół operacyjny abduktorów
    .desc = Stół chirurgiczny obcej konstrukcji. Przyspiesza operacje na przypiętym pacjencie.
ent-AbductorGlandDispenser = dystrybutor gruczołów
    .desc = Przechowuje organy zastępcze dla okazów.
ent-BaseOrganAbductorGland = obcy gruczoł
    .desc = Pulsujący organ obcego pochodzenia. Pracuje jak serce i robi coś jeszcze.
ent-AbductorCuffs = obce więzy
    .desc = Cienkie opaski z obcego materiału. Po zdjęciu rozpadają się.
ent-Wonderprod = pałka abduktora
    .desc = Uniwersalne narzędzie Wydziału Sondowania. Użyj w ręce, aby zmienić tryb.
ent-MechanicalPinchesAbductor = obcy rozwieracz
    .desc = Zaawansowany rozwieracz, który działa też jak kleszczyki.
ent-SearingToolAbductor = obcy kauter
    .desc = Kauter z energetyczną końcówką, który zastępuje też szwy.
ent-EnergyScalpelAbductor = obcy skalpel energetyczny
    .desc = Skalpel z ostrzem energetycznym, który tnie też jak piła i wierci jak wiertło.
ent-BoneManipulatorAbductor = obcy manipulator kości
    .desc = Zaawansowane narzędzie do składania kości.
ent-ActionAbductorRecall = Powrót na statek
    .desc = Po widocznym ładowaniu przenosi cię na telepad. Ruch albo obrażenia je przerywają.
ent-ActionAbductorSendPad = Wyślij z telepadu
    .desc = Wysyła wszystkich z telepadu w oglądane miejsce. Lądowanie widać, zanim nastąpi.
ent-ActionAbductorSendSelf = Zejdź na stację
    .desc = Przenosi cię w oglądane miejsce. Lądowanie widać, zanim nastąpi.
ent-ActionAbductorRetrieve = Ściągnij okaz
    .desc = Przenosi oznaczony okaz na telepad razem z tobą i kończy obserwację. Okaz musi być obezwładniony i wolny.
ent-ActionAbductorSetRelease = Ustaw punkt zwrotu
    .desc = Gotowe okazy będą wracać w oglądane miejsce.
ent-ActionAbductorExitObservation = Odejdź od konsoli
    .desc = Kończy obserwację stacji.
ent-MobAbductorSpiderling = pajączek
    .desc = Mały, nerwowy i zdecydowanie nie powinien był mieszkać w czyimś ciele.
ent-WeaponAbductorShrinkRay = promień zmniejszający
    .desc = Obcy sprzęt o niejasnym przeznaczeniu. Trafiony cel kurczy się o połowę i staje się znacznie bardziej kruchy.
ent-StatusEffectAbductorShrink = zmniejszenie
ent-BulletAbductorShrink = pocisk zmniejszający
ent-MobAbductor = abduktor
ent-AbductorObservationEye = oko obserwacyjne
ent-ClothingUniformJumpsuitAbductor = kombinezon abduktora
    .desc = Bezszwowy strój utkany z obcego włókna.
ent-ClothingBackpackAbductor = obcy plecak
    .desc = Zwykły plecak utkany z wytrzymałego włókna.
ent-ClothingBackpackDuffelAbductor = obca torba podróżna
    .desc = Zwykła torba podróżna utkana z wytrzymałego włókna.
ent-ClothingHeadsetAltAbductor = nauszny zestaw słuchawkowy abduktora
    .desc = Nastrojony na kanał, którego żadna stacja nie usłyszy.
ent-EncryptionKeyAbductor = obcy klucz szyfrujący
    .desc = Chip szyfrujący obcej roboty.
ent-ClothingHeadHelmetAbductor = obcy hełm
    .desc = Gładki hełm wyprofilowany pod znacznie większą czaszkę.
ent-ClothingOuterArmorAbductor = kamizelka agenta
    .desc = Kamizelka obcej roboty dla tych, którzy zbierają okazy.
ent-ClothingOuterCoatAbductor = obcy fartuch laboratoryjny
    .desc = Fartuch obcego pochodzenia. Chroni przed różnymi urazami i rozlanymi chemikaliami.
ent-TableAbductor = obcy stół
    .desc = Trudno wyobrazić sobie coś solidniejszego.
ent-WallAbductor = ściana wahadłowca
    .desc = Zatrzymuje powietrze w środku i krwiożerczych złomiarzy na zewnątrz.
    .suffix = abduktorzy
ent-WallAbductorDiagonal = ściana wahadłowca
    .desc = { ent-WallAbductor.desc }
    .suffix = skośna, abduktorzy
ent-SpawnPointLoneAbductor = punkt odrodzenia samotnego abduktora
ent-SpawnPointAbductorScientist = punkt odrodzenia abduktora naukowca
ent-SpawnPointAbductorAgent = punkt odrodzenia abduktora agenta
ent-MindRoleAbductorLone = Rola samotnego abduktora
ent-MindRoleAbductorScientist = Rola abduktora naukowca
ent-MindRoleAbductorAgent = Rola abduktora agenta
ent-MindRoleAbducteeHarmless = Rola ofiary abduktorów (niegroźna)
ent-MindRoleAbducteeAnnoying = Rola ofiary abduktorów (Wolny Agent)
ent-MindRoleAbducteeHarmful = Rola ofiary abduktorów (Solo Antagonista)
