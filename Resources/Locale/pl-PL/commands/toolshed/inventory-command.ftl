command-description-inventory-getflags = Pobiera wszystkie encje w slotach przekazanej potokiem encji z ekwipunkiem, pasujące do danej flagi slotu.
command-description-inventory-getnamed = Pobiera wszystkie encje w slotach przekazanej potokiem encji z ekwipunkiem, pasujące do danej nazwy slotu.
command-description-inventory-forceput = Zakłada daną encję na pierwszą przekazaną potokiem encję, która ma slot pasujący do danej flagi, usuwając przedmiot znajdujący się wcześniej w tym slocie.
command-description-inventory-forcespawn = Tworzy dany prototyp na pierwszej przekazanej potokiem encji, która ma slot pasujący do danej flagi, usuwając przedmiot znajdujący się wcześniej w tym slocie.
command-description-inventory-put = Zakłada daną encję na pierwszą przekazaną potokiem encję, która ma slot pasujący do danej flagi, zdejmując przedmiot znajdujący się wcześniej w tym slocie.
command-description-inventory-spawn = Tworzy dany prototyp na pierwszej przekazanej potokiem encji, która ma slot pasujący do danej flagi, zdejmując przedmiot znajdujący się wcześniej w tym slocie.
command-description-inventory-tryput = Próbuje założyć daną encję na pierwszą przekazaną potokiem encję, która ma slot pasujący do danej flagi, kończąc się niepowodzeniem, jeśli w slocie jest już jakiś przedmiot.
command-description-inventory-tryspawn = Próbuje utworzyć dany prototyp na pierwszej przekazanej potokiem encji, która ma slot pasujący do danej flagi, kończąc się niepowodzeniem, jeśli w slocie jest już jakiś przedmiot.
command-description-inventory-ensure = Zakłada daną encję na pierwszą przekazaną potokiem encję, która ma slot pasujący do danej flagi, jeśli nic w nim nie ma, i przekazuje dalej UID tego, co ostatecznie znajduje się w slocie.
command-description-inventory-ensurespawn = Tworzy dany prototyp na pierwszej przekazanej potokiem encji, która ma slot pasujący do danej flagi, jeśli nic w nim nie ma, i przekazuje dalej UID tego, co ostatecznie znajduje się w slocie.
command-description-inventory-contents = Pobiera encje w slotach ekwipunku przekazanych potokiem encji i przekazuje je dalej.
