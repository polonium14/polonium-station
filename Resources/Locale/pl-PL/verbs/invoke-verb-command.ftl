### Localization used for the invoke verb command.


# Mostly help + error messages.

invoke-verb-command-description = Wywołuje akcję o podanej nazwie na encji, z encją gracza jako użytkownikiem
invoke-verb-command-help = invokeverb <playerUid | "self"> <targetUid> <verbName | "interaction" | "activation" | "alternative">
invoke-verb-command-invalid-args = invokeverb przyjmuje 2 argumenty.
invoke-verb-command-invalid-player-uid = Nie udało się odczytać uid gracza lub nie podano „self”.
invoke-verb-command-invalid-target-uid = Nie udało się odczytać uid celu.
invoke-verb-command-invalid-player-entity = Podany uid gracza nie odpowiada żadnej prawidłowej encji.
invoke-verb-command-invalid-target-entity = Podany uid celu nie odpowiada żadnej prawidłowej encji.
invoke-verb-command-success = Wywołano akcję „{ $verb }” na { $target }, a użytkownikiem jest { $player }.
invoke-verb-command-verb-not-found = Nie znaleziono akcji { $verb } na { $target }.
