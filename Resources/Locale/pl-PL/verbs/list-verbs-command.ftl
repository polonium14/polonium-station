### Localization used for the list verbs command.


# Mostly help + error messages.

list-verbs-command-description = Wyświetla wszystkie akcje, których gracz może użyć na danej encji.
list-verbs-command-help = listverbs <playerUid | "self"> <targetUid>
list-verbs-command-invalid-args = listverbs przyjmuje 2 argumenty.
list-verbs-command-invalid-player-uid = Nie udało się odczytać uid gracza lub nie podano „self”.
list-verbs-command-invalid-target-uid = Nie udało się odczytać uid celu.
list-verbs-command-invalid-player-entity = Podany uid gracza nie odpowiada żadnej prawidłowej encji.
list-verbs-command-invalid-target-entity = Podany uid celu nie odpowiada żadnej prawidłowej encji.
list-verbs-verb-listing = { $type }: { $verb }
