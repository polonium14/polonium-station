execution-verb-name = Zabij
execution-verb-message = Użyj swojej broni aby kogoś zabić.

# All the below localisation strings have access to the following variables
# attacker (the person committing the execution)
# victim (the person being executed)
# weapon (the weapon used for the execution)

execution-popup-melee-initial-internal = Zbliżasz { $weapon } do gardła { $victim }.
execution-popup-melee-initial-external = { CAPITALIZE($attacker) } zbliża { POSS-ADJ($attacker) } { $weapon } do gardła { $victim }.
execution-popup-melee-complete-internal = Podżynasz gardło { $victim }!
execution-popup-melee-complete-external = { CAPITALIZE($attacker) } podżyna gardło { $victim }!
execution-popup-self-initial-internal = Zbliżasz { $weapon } do swojego gardła.
execution-popup-self-initial-external = { CAPITALIZE($attacker) } zbliża { POSS-ADJ($attacker) } { $weapon } do swojego dardła.
execution-popup-self-complete-internal = Podżynasz sobie gardło!
execution-popup-self-complete-external = { CAPITALIZE($attacker) } podżyna swoje gardło!
gun-execution-initial-self = Przystawiasz { THE($weapon) } do głowy { THE($victim) }.
gun-execution-initial-others = { CAPITALIZE(THE($attacker)) } przystawia { POSS-ADJ($attacker) } { $weapon } do głowy { THE($victim) }.
gun-execution-complete-self = Naciskasz spust i dokonujesz egzekucji { THE($victim) }!
gun-execution-complete-others = { CAPITALIZE(THE($attacker)) } naciska spust i dokonuje egzekucji { THE($victim) }!
gun-execution-suicide-initial-self = Przykładasz { THE($weapon) } pod brodę.
gun-execution-suicide-initial-others = { CAPITALIZE(THE($attacker)) } przykłada { POSS-ADJ($attacker) } { $weapon } pod brodę.
gun-execution-suicide-complete-self = Naciskasz spust!
gun-execution-suicide-complete-others = { CAPITALIZE(THE($attacker)) } naciska spust!
gun-execution-empty-self = { THE($weapon) } klika. Brak amunicji.
gun-execution-empty-others = { CAPITALIZE(THE($attacker)) }: { $weapon } klika. Brak amunicji.
