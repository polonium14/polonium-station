execution-verb-name = Zabij
execution-verb-message = Użyj swojej broni aby kogoś zabić.

# All the below localisation strings have access to the following variables
# attacker (the person committing the execution)
# victim (the person being executed)
# weapon (the weapon used for the execution)

execution-popup-melee-initial-internal = Zbliżasz {THE($weapon)} do gardła {THE($victim)}.
execution-popup-melee-initial-external = { CAPITALIZE(THE($attacker)) } zbliża {POSS-ADJ($attacker)} {$weapon} do gardła {THE($victim)}.
execution-popup-melee-complete-internal = Podżynasz gardło {THE($victim)}!
execution-popup-melee-complete-external = { CAPITALIZE(THE($attacker)) } podżyna gardło {THE($victim)}!

execution-popup-self-initial-internal = Zbliżasz {THE($weapon)} do swojego gardła.
execution-popup-self-initial-external = { CAPITALIZE(THE($attacker)) } zbliża {POSS-ADJ($attacker)} {$weapon} do swojego dardła.
execution-popup-self-complete-internal = Podżynasz sobie gardło!
execution-popup-self-complete-external = { CAPITALIZE(THE($attacker)) } podżyna swoje gardło!
