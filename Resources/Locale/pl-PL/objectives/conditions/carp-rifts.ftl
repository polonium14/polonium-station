objective-carp-rifts-title =
    Otwórz { $count } karpio { $count ->
        [one] wyrwę
       *[few] wyrwy
        [many] wyrw
    }.
objective-carp-rifts-description =
    Użyj akcji otwierania wyrwy aby otworzyć { $count } karpio { $count ->
        [one] wyrwę
       *[few] wyrwy
        [many] wyrw
    } i dopilnuj aby nie zostały zniszczone. Umrzesz jeśli przez 5 minut żadna wyrwa nie będzie otwarta.
