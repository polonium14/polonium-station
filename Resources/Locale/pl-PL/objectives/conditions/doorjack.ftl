objective-condition-doorjack-title =
    Otwórz { $count } { $count ->
        [one] parę drzwi
        [few] pary drzwi
       *[many] par drzwi
    } na stacji.
objective-condition-doorjack-description =
    Twoje rękawice mogą hakować śluzy. Zhakuj { $count } { $count ->
        [one] parę drzwi
        [few] pary drzwi
       *[many] par drzwi
    } na stacji.
