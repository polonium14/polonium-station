

ent-InflatableDock = nadmuchiwana śluza dokująca
    .desc = Nadmuchiwana membrana z wzmocnionymi punktami mocowania, zdolna do dokowania. Zawór zwalniający do spuszczania powietrza. Nie przebijaj.
    .suffix = Dokowanie

ent-InflatableWall = inflatable barricade
    .desc = An inflated membrane. Release valve to deflate. Do not puncture.

ent-InflatableDoor = inflatable door
    .desc = An inflated, semi-traversable membrane. Otherwise known as a door. Release valve to deflate. Do not puncture.
