ent-BaseReplicatorColossusPart = { ent-BaseItem }
    .desc = { ent-BaseItem.desc }
ent-ReplicatorColossusPartHull = kadłub kolosa
    .desc = Opancerzony brzuch Kolosalnego Replikatora. Przykręca się do niego wszystkie pozostałe części.
ent-ReplicatorColossusPartDrive = napęd kolosa
    .desc = Blok siłowników nawinięty z nanitów, który zamienia moc kadłuba w krok sześciu nóg.
ent-ReplicatorColossusPartLeg = noga kolosa
    .desc = Przegubowa noga wysoka jak człowiek, zakończona szponem, który wgryza się w poszycie pokładu.
ent-ReplicatorColossusPartHead = głowa kolosa
    .desc = Płaska czasza czujników z ciemnym wizjerem. Śledzi ruch nawet wtedy, gdy nic jej nie zasila.
ent-ReplicatorColossusPartFieldGenerator = generator pola kolosa
    .desc = Cewka bluespace'u, która zagina przestrzeń wokół kolosa i odrzuca intruzów daleko stąd.
ent-ReplicatorColossusPartMinigun = fotonowy minigun kolosa
    .desc = Obrotowy emiter, który pluje pociskami światła szybciej, niż nadąża oko.
ent-ReplicatorColossusPartPhotonLaser = lasery fotonowe kolosa
    .desc = Barkowe gondole laserowe, które rozsiewają nanity po ścianach i podłogach.
ent-ReplicatorColossusPartTentacles = macki kolosa
    .desc = Wiązka segmentowych kabli, które wloką się za kolosem i karmią go materią.
ent-ReplicatorColossusPartCore = rdzeń kolosa
    .desc = Zamknięty w klatce kryształ kipiącego magentowego światła. Gdy trafi do kadłuba, kolosowi brakuje już tylko umysłu.
ent-ReplicatorColossusCoreSalvage = wypalony rdzeń kolosa
    .desc = Rdzeń Kolosalnego Replikatora wycięty z jego wraku. Nanity w nim są martwe, ale siatka, którą po sobie zostawiły, wciąż pokazuje, jak namierzały ofiary.
