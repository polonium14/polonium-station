ent-BaseModSuitModule = { ent-BaseItem }
    .desc = { ent-BaseItem.desc }
ent-BaseModSuitModuleToggle = { ent-BaseModSuitModule }
    .desc = { ent-BaseModSuitModule.desc }
ent-BaseModSuitModuleAction = { ent-BaseModSuitModuleToggle }
    .desc = { ent-BaseModSuitModuleToggle.desc }
ent-BaseModSuitModuleStorage = { ent-BaseModSuitModule }
    .desc = { ent-BaseModSuitModule.desc }
ent-ModSuitModuleStorageNormal = moduł schowka R.I.G.
    .desc = Zestaw schowków i kieszeni wbudowanych w kombinezon. Każdy R.I.G. ma go od nowości.
ent-ModSuitModuleStorageExpanded = moduł powiększonego schowka R.I.G.
    .desc = Ukryte schowki rozmieszczone w całym kombinezonie, z dużo większą pojemnością niż zwykły schowek.
ent-ModSuitModuleStorageSyndie = moduł schowka R.I.G. syndykatu
    .desc = Schowek od Cybersun, który zmniejsza włożone do niego przedmioty.
ent-ModSuitModuleJetpackNormal = moduł plecaka odrzutowego R.I.G.
    .desc = Elektryczne silniki rozmieszczone na kombinezonie, które zamiast spalać gaz przyspieszają jony energią z baterii.
ent-ModSuitModuleMagboots = moduł stabilizacji magnetycznej R.I.G.
    .desc = Silne elektromagnesy wbudowane w buty kombinezonu.
ent-ModSuitModuleMobility = moduł ulepszonej mobilności R.I.G.
    .desc = Serwomechanizmy w stawach kombinezonu, które pomagają użytkownikowi poruszać się szybciej kosztem dużego zużycia energii.
ent-ModSuitModuleInsulation = moduł izolacji R.I.G.
    .desc = Izolująca wyściółka rękawic kombinezonu. Działa, gdy rękawice są uszczelnione.
ent-ModSuitModuleVisionWelding = moduł ochrony spawalniczej R.I.G.
    .desc = Polaryzująca nakładka przed oczami, która chroni je przed spawaniem i jasnymi błyskami. Działa, gdy hełm jest uszczelniony.
ent-BaseModSuitModuleVision = { ent-BaseModSuitModuleAction }
    .desc = { ent-BaseModSuitModuleAction.desc }
ent-ModSuitModuleVisionMed = moduł wizjera medycznego R.I.G.
    .desc = Zestaw skanerów biologicznych w hełmie, który pokazuje stan zdrowia istot żywych wokół użytkownika.
ent-ModSuitModuleVisionDiagnostic = moduł wizjera diagnostycznego R.I.G.
    .desc = Czujniki w hełmie, które pokazują stan maszyn, cyborgów i egzoszkieletów.
ent-ModSuitModuleVisionSec = moduł wizjera ochrony R.I.G.
    .desc = System celowniczy połączony z kartoteką kryminalną, który pokazuje stanowiska, tarcze umysłu i status osób wokół.
ent-ModSuitModuleVisionMeson = moduł wizjera mezonowego R.I.G.
    .desc = Technologia skanera mezonowego wbudowana w hełm, która ukazuje rury i kable pod podłogą.
ent-ModSuitModuleVisionNight = moduł noktowizji R.I.G.
    .desc = Wzmacniacze światła w hełmie, dzięki którym użytkownik widzi w całkowitej ciemności.
