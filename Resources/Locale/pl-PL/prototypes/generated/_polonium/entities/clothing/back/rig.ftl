ent-ClothingBackpackModSuitBase = { ent-Clothing }
    .desc = { ent-Clothing.desc }
ent-ClothingBackpackModSuitEngineering = R.I.G. inżynieryjny
    .desc = Modułowy kombinezon do prac inżynieryjnych. Ma osłonę przed promieniowaniem.
ent-ClothingBackpackModSuitAtmospheric = R.I.G. atmosferyczny
    .desc = Modułowy kombinezon dla techników atmosferyki. Odporny na ogień i wysoką temperaturę.
ent-ClothingBackpackModSuitMedical = R.I.G. medyczny
    .desc = Lekki modułowy kombinezon dla personelu medycznego pracującego w niebezpiecznym środowisku.
ent-ClothingBackpackModSuitSecurity = R.I.G. ochrony
    .desc = Opancerzony modułowy kombinezon do działań ochrony w niebezpiecznym środowisku.
ent-ClothingBackpackModSuitSalvage = R.I.G. górniczy
    .desc = Wytrzymały modułowy kombinezon dla specjalistów ds. odzysku pracujących poza stacją.
ent-ClothingBackpackModSuitCivilian = R.I.G. cywilny
    .desc = Prosty modułowy kombinezon, który utrzymuje użytkownika przy życiu w kosmosie. Mieści niewiele modułów.
ent-ClothingBackpackModSuitSyndicate = R.I.G. syndykatu
    .desc = Krwistoczerwony modułowy kombinezon z pancerzem zakazanym w większości sektora. Własność Maruderów Gorlex.
ent-ClothingBackpackModSuitSyndicateFilled = { ent-ClothingBackpackModSuitSyndicate }
    .suffix = Pełny
    .desc = { ent-ClothingBackpackModSuitSyndicate.desc }
ent-ClothingBackpackModSuitElite = elitarny R.I.G. syndykatu
    .desc = Elitarny modułowy kombinezon ulepszony przez Cybersun, z lepszym pancerzem i ognioodpornością.
ent-ClothingBackpackModSuitEliteFilled = { ent-ClothingBackpackModSuitElite }
    .suffix = Pełny
    .desc = { ent-ClothingBackpackModSuitElite.desc }
