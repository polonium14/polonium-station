ent-BaseWizardKillObjective = { ent-BaseWizardTargetObjective }
    .desc = { ent-BaseWizardTargetObjective.desc }
ent-WizardKillHeadObjective = { ent-BaseWizardKillObjective }
    .desc = Ta osoba z dowództwa śmiała drwić z Federacji. Niech cała stacja zobaczy, jak kończą niedowiarkowie.
ent-WizardKillChaplainObjective = { ent-BaseWizardKillObjective }
    .desc = Kapelan tej stacji głosi, że magia to herezja. Pokaż, ile warte są modlitwy wobec prawdziwej mocy.
ent-WizardKillSecurityObjective = { ent-BaseWizardKillObjective }
    .desc = Ochrona tej stacji zamknęła w celi już niejednego ucznia Federacji. Czas wyrównać rachunki.
ent-WizardKillScientistObjective = { ent-BaseWizardKillObjective }
    .desc = Ta osoba próbuje rozłożyć magię na wzory i wykresy. Federacja nie lubi, gdy ktoś zagląda w jej sekrety.
ent-BaseWizardMaroonObjective = { ent-BaseWizardKillObjective }
    .desc = { ent-BaseWizardKillObjective.desc }
ent-WizardMaroonCaptainObjective = { ent-BaseWizardMaroonObjective }
    .desc = Federacja ma wobec kapitana własne plany. Bez względu na to, czy przeżyje, nie może wrócić do Centrali.
ent-WizardMaroonRandomObjective = { ent-BaseWizardMaroonObjective }
    .desc = Ta osoba widziała za dużo. Nie może opowiedzieć o tym w Centrali.
ent-BaseWizardCluwneObjective = { ent-BaseWizardTargetObjective }
    .desc = { ent-BaseWizardTargetObjective.desc }
ent-WizardCluwneTargetObjective = { ent-BaseWizardCluwneObjective }
    .desc = Ktoś musi zostać pośmiewiskiem stacji. Rzuć Cluwne's Curse i dopilnuj, by ofiara dotrwała do końca zmiany, bo martwy cluwne nikogo nie śmieszy.
ent-WizardCluwneHeadObjective = { ent-BaseWizardCluwneObjective }
    .desc = Nic tak nie uczy pokory jak czerwony nos. Rzuć Cluwne's Curse na tę osobę z dowództwa i niech dowodzi dalej, aż do końca zmiany.
ent-WizardCluwneClownObjective = { ent-BaseWizardCluwneObjective }
    .desc = Klaun tej stacji parodiuje czarodziejów na każdym występie. Pokaż, jak wygląda prawdziwy żart, rzucając Cluwne's Curse. Ofiara musi dotrwać do końca zmiany.
ent-BaseWizardPolymorphObjective = { ent-BaseWizardTargetObjective }
    .desc = { ent-BaseWizardTargetObjective.desc }
ent-WizardPolymorphTargetObjective = { ent-BaseWizardPolymorphObjective }
    .desc = Ta osoba lepiej sprawdzi się z płetwami. Zamień ją w zwierzę różdżką polimorfii karpia i dopilnuj, by w tej postaci dotrwała do końca zmiany.
ent-WizardPolymorphHeadObjective = { ent-BaseWizardPolymorphObjective }
    .desc = Ktoś, kto tak lubi wydawać rozkazy, niech spróbuje je wydawać bulgotaniem. Zamień tę osobę z dowództwa w zwierzę różdżką polimorfii karpia i nie pozwól jej wrócić do ludzkiej postaci przed końcem zmiany.
ent-WizardChosenOneObjective = { ent-BaseWizardTargetObjective }
    .desc = Federacja wybrała tę osobę na przyszłego ucznia, choć ona sama jeszcze o tym nie wie. Musi przeżyć zmianę.
ent-WizardCluwneCountObjective = { ent-BaseWizardObjective }
    .desc = Federacja uwielbia cyrk. Wszyscy przeklęci przez Cluwne's Curse muszą żyć na koniec zmiany.
ent-WizardPolymorphCountObjective = { ent-BaseWizardObjective }
    .desc = Stacji przyda się menażeria. Osoby trafione różdżką polimorfii karpia muszą dotrwać do końca zmiany w zwierzęcej postaci.
ent-WizardSlipperyCountObjective = { ent-BaseWizardObjective }
    .desc = Nic tak nie ożywia stacji jak załoga przewracająca się o siebie nawzajem. Ofiary zaklęcia muszą żyć na koniec zmiany.
ent-WizardAnimateCountObjective = { ent-BaseWizardObjective }
    .desc = Krzesła, szafy, automaty: dzięki Staff of Animation wszystko może zyskać własną wolę. Ożywione przedmioty muszą wciąż grasować po stacji na koniec zmiany.
ent-WizardDoorCountObjective = { ent-BaseWizardObjective }
    .desc = Architektura NanoTrasen jest śmiertelnie nudna. Pokaż różdżką wejścia, jak wygląda stacja urządzona przez czarodzieja. Drzwi muszą stać do końca zmiany.
ent-WizardRedAlertObjective = Zmuś stację do ogłoszenia czerwonego alarmu.
    .desc = Niech wiedzą, że Federacja tu jest. Dowództwo musi ogłosić co najmniej czerwony alarm.
