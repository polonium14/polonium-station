ent-ClothingOuterHardsuitAtmos = skafander atmosferyczny
    .desc = Specjalny kombinezon chroniący przed niebezpiecznym środowiskiem o niskim ciśnieniu. Ma osłonę termiczną.
ent-ClothingOuterHardsuitEngineering = skafander inżynieryjny
    .desc = Specjalny kombinezon chroniący przed niebezpiecznym środowiskiem o niskim ciśnieniu. Ma osłonę przed promieniowaniem.
ent-ClothingOuterHardsuitSpatio = skafander spationauty
    .desc = Lekki skafander do przemysłowego EVA w zerowej grawitacji.
ent-ClothingOuterHardsuitSalvage = skafander górniczy
    .desc = Specjalny kombinezon chroniący przed niebezpiecznym środowiskiem o niskim ciśnieniu. Ma wzmocnione płyty na spotkania z dziką fauną.
ent-ClothingOuterHardsuitGoliath = skafander z goliatha
    .desc = Lekki skafander ozdobiony mozaiką grubej, chitynowej skóry goliatha.
ent-ClothingOuterHardsuitMaxim = skafander maxim odzysku
    .desc = Ogień. Żar. Te rzeczy kują wielką broń, kują też wielkich specjalistów ds. odzysku.
ent-ClothingOuterHardsuitSecurity = skafander ochrony
    .desc = Specjalny kombinezon chroniący przed niebezpiecznym środowiskiem o niskim ciśnieniu. Ma dodatkową warstwę pancerza.
ent-ClothingOuterHardsuitBrigmedic = skafander medyka więziennego
    .desc = Specjalny skafander anioła stróża aresztu. Medyczna wersja skafandra ochrony.
ent-ClothingOuterHardsuitWarden = skafander nadzorcy ochrony
    .desc = Specjalistyczny kombinezon do tłumienia zamieszek, przystosowany do niskiego ciśnienia.
ent-ClothingOuterHardsuitCap = opancerzony skafander kapitana
    .desc = Galowy opancerzony skafander, zrobiony dla kapitana stacji.
ent-ClothingOuterHardsuitEngineeringWhite = skafander głównego inżyniera
    .desc = Specjalny skafander chroniący przed niebezpiecznym środowiskiem o niskim ciśnieniu, zrobiony dla głównego inżyniera stacji.
ent-ClothingOuterHardsuitMedical = skafander ordynatora
    .desc = Specjalny kombinezon chroniący przed niebezpiecznym środowiskiem o niskim ciśnieniu. Wykonany z lekkich materiałów, by ułatwić ruch.
ent-ClothingOuterHardsuitRd = eksperymentalny skafander badawczy
    .desc = Specjalny kombinezon chroniący przed niebezpiecznym środowiskiem o niskim ciśnieniu. Ma dodatkową warstwę pancerza.
ent-ClothingOuterHardsuitSecurityRed = skafander komendanta
    .desc = Specjalny kombinezon chroniący przed niebezpiecznym środowiskiem o niskim ciśnieniu. Ma dodatkową warstwę pancerza.
ent-ClothingOuterHardsuitLuxury = luksusowy skafander górniczy
    .desc = Odnowiony skafander górniczy w barwach kwatermistrza. Wyściółka grafenowa daje mniejszą ochronę, ale o wiele łatwiej się w nim ruszać.
ent-ClothingOuterHardsuitSyndie = krwistoczerwony skafander
    .desc = Ciężko opancerzony skafander do operacji specjalnych. Własność Maruderów Gorlex.
ent-ClothingOuterHardsuitSyndieMedic = krwistoczerwony skafander medyczny
    .desc = Ciężko opancerzony i zwinny zaawansowany skafander specjalnie do operacji medyka polowego.
ent-ClothingOuterHardsuitSyndieElite = elitarny skafander syndykatu
    .desc = Elitarna wersja krwistoczerwonego skafandra, z lepszą odpornością na promieniowanie i ognioodpornością. Własność Maruderów Gorlex.
ent-ClothingOuterHardsuitSyndieCommander = skafander dowódcy syndykatu
    .desc = Powiększona wersja krwistoczerwonego skafandra, zbudowana dla dowódcy oddziału operatorów Syndykatu. Znacznie lepszy pancerz na śmiertelne starcia na froncie.
ent-ClothingOuterHardsuitJuggernaut = juggernauta Cybersun kombinezon
    .desc = Kombinezon stworzony przez najnowocześniejszy dział B+R Cybersun, by być hiperodpornym.
ent-ClothingOuterHardsuitWizard = skafander czarodzieja
    .desc = Dziwaczny kombinezon inkrustowany klejnotami, promieniujący magiczną energią.
ent-ClothingOuterHardsuitLing = organiczny kosmiczny kombinezon
    .desc = Przystosowana do kosmosu biomasa tkanki odpornej na ciśnienie i temperaturę.
ent-ClothingOuterHardsuitPirateEVA = głębokiego kosmosu skafander EVA
    .desc = Ciężki skafander dający podstawową ochronę przed zimnymi realiami głębokiego kosmosu.
    .suffix = Pirat
ent-ClothingOuterHardsuitPirateCap = skafander kapitana piratów
    .desc = Starożytny opancerzony skafander, idealny przeciw kosmicznemu szkorbutowi i łotrzykom z narzędziami.
ent-ClothingOuterHardsuitERTLeader = skafander lidera JSR
    .desc = Ochronny skafander noszony przez lidera Jednostki Szybkiego Reagowania.
ent-ClothingOuterHardsuitERTChaplain = skafander kapłana JSR
    .desc = Ochronny skafander noszony przez kapłanów Jednostki Szybkiego Reagowania.
ent-ClothingOuterHardsuitERTEngineer = skafander inżyniera JSR
    .desc = Ochronny skafander noszony przez inżynierów Jednostki Szybkiego Reagowania.
ent-ClothingOuterHardsuitERTMedical = skafander medyka JSR
    .desc = Ochronny skafander noszony przez medyków Jednostki Szybkiego Reagowania.
ent-ClothingOuterHardsuitERTSecurity = skafander ochrony JSR
    .desc = Ochronny skafander noszony przez oficerów ochrony Jednostki Szybkiego Reagowania.
ent-ClothingOuterHardsuitERTJanitor = skafander sprzątacza JSR
    .desc = Ochronny skafander noszony przez sprzątaczy Jednostki Szybkiego Reagowania.
ent-ClothingOuterHardsuitDeathsquad = skafander szwadronu śmierci
    .desc = Zaawansowany skafander lubiany przez komandosów do operacji specjalnych.
ent-ClothingOuterHardsuitCBURN = egzoszkielet CBURN
    .desc = Lekki, a zarazem mocny egzoszkielet do specjalnych operacji porządkowych.
ent-ClothingOuterHardsuitClown = skafander klauna
    .desc = Skafander klauna na zamówienie.
ent-ClothingOuterHardsuitMime = skafander mima
    .desc = Skafander mima na zamówienie.
ent-ClothingOuterHardsuitSanta = skafander Mikołaja
    .desc = Odświętny, radosny skafander chroniący wesołego dawcę prezentów podczas saneczkowych przejażdżek w kosmosie. Daje trochę odporności na uderzenia asteroid.
