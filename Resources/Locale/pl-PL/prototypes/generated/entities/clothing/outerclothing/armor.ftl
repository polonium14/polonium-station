ent-ClothingOuterArmorBase = kamizelka ochronna
    .desc = Standardowa kamizelka pancerna typu I, zapewniająca przyzwoitą ochronę przed większością rodzajów obrażeń.
ent-ClothingOuterArmorBasic = { ent-BaseSecurityContraband }
    .desc = { ent-BaseSecurityContraband.desc }
ent-ClothingOuterArmorBasicSlim = kamizelka ochronna
    .desc = Smukła kamizelka pancerna typu I, zapewniająca przyzwoitą ochronę przed większością rodzajów obrażeń.
    .suffix = smukła
ent-ClothingOuterArmorBulletproof = bulletproof suit
    .desc = A Type III heavy bulletproof suit that excels in protecting the wearer against traditional projectile weaponry and explosives to a minor extent.
ent-ClothingOuterArmorReflective = kamizelka reflective
    .desc = Opancerzona kamizelka z zaawansowaną osłoną przed bronią energetyczną.
ent-ClothingOuterVestDetective = kamizelka detektywa
    .desc = Pancerna kamizelka nieugiętego prywatnego detektywa.
ent-ClothingOuterArmorBaseCarapace = { ent-ClothingOuterBaseMedium }
    .desc = { ent-ClothingOuterBaseMedium.desc }
ent-ClothingOuterArmorCaptainCarapace = karapaks kapitana
    .desc = Opancerzony napierśnik dający ochronę przy zachowaniu maksymalnej mobilności. Tylko dla najlepszych na stacji.
ent-ClothingOuterArmorCentcommCarapace = karapaks CD
    .desc = Opancerzony napierśnik dający ochronę przy zachowaniu maksymalnej mobilności. Tylko dla urzędników i agentów CD.
ent-ClothingOuterVestWeb = kamizelka taktyczna
    .desc = Syntetyczna kamizelka pancerna. Posiada dodatkowe taśmy i płyty balistyczne.
ent-ClothingOuterVestWebElite = aramidowa kamizelka taktyczna
    .desc = Syntetyczna kamizelka pancerna. Posiada dodatkowe taśmy i włókna odporne na ciepło.
ent-ClothingOuterVestWebMerc = kamizelka najemnika
    .desc = Wysokiej jakości kamizelka pancerna wykonana z twardego materiału syntetycznego. Jest zaskakująco elastyczna i lekka, mimo solidnego opancerzenia.
ent-ClothingOuterArmorRaid = szturmowy kombinezon syndykatu
    .desc = Dość elastyczny, dobrze opancerzony kombinezon z silną latarką naramienną w krwistoczerwonych barwach Maruderów Gorlex; nie chroni przed kosmosem.
ent-ClothingOuterArmorRiot = riot kombinezon
    .desc = Półelastyczny pancerz poliwęglanowy z ciężkim wyścieleniem na ataki wręcz. Idealny do walki z chuliganami na stacji.
ent-ClothingOuterArmorCult = pancerz acolyte
    .desc = Złowieszczo wyglądający pancerz kultu, z kości.
ent-ClothingOuterArmorHeavy = kombinezon heavy armor
    .desc = Ciężko opancerzony kombinezon chroniący przed nadmiernymi obrażeniami.
ent-ClothingOuterArmorHeavyGreen = zielony kombinezon heavy armor
    .desc = Ciężko opancerzony kombinezon z zielonymi akcentami, chroniący przed nadmiernymi obrażeniami.
ent-ClothingOuterArmorHeavyRed = czerwony kombinezon heavy armor
    .desc = Ciężko opancerzony kombinezon z czerwonymi akcentami, chroniący przed nadmiernymi obrażeniami.
ent-ClothingOuterArmorMagusblue = niebieski pancerz magus
    .desc = Niebieski opancerzony kombinezon dający dobrą ochronę.
ent-ClothingOuterArmorMagusred = czerwony pancerz magus
    .desc = Czerwony opancerzony kombinezon dający dobrą ochronę.
ent-ClothingOuterArmorChangeling = chitynowy pancerz
    .desc = Rozdyma ciało changelinga w wszystkożerną chitynową masę pancerza.
ent-ClothingOuterArmorBone = kostny pancerz
    .desc = Leży na tobie jak druga skóra.
ent-ClothingOuterArmorPodWars = ironclad II pancerz
    .desc = Przerobiony pancerz ironclad II, relikt wojen podów.
ent-CardArmour = tekturowy pancerz
    .desc = Średniowieczny napierśnik z tektury.
