ent-ClothingOuterSuitBomb = kombinezon BOMB
    .desc = Ciężki kombinezon zaprojektowany, by wytrzymać ciśnienie wybuchu bomby i odłamki.
ent-ClothingOuterSuitJanitorBomb = kombinezon woźnego BOMB
    .desc = Ciężki pancerz zaprojektowany, by wytrzymać wybuchy z reakcji chemicznych.
ent-ClothingOuterSuitFire = strażacki kombinezon
    .desc = Kombinezon pomagający chronić przed niebezpiecznymi temperaturami.
ent-ClothingOuterSuitAtmosFire = strażacki atmosferyczny kombinezon
    .desc = Drogi kombinezon strażacki chroniący nawet przed najgroźniejszymi pożarami stacji. Chroni nawet gdy noszący płonie.
ent-ClothingOuterSuitRad = kombinezon radiation
    .desc = Kombinezon chroniący przed promieniowaniem. Na metce: „Zrobione z ołowiu. Proszę nie jeść izolacji.”
ent-ClothingOuterSuitSpaceNinja = kombinezon kosmicznego ninja
    .desc = Ten czarny, zaawansowany technologicznie, cybernetycznie wzmocniony kombinezon daje wiele zdolności, jak niewidzialność czy teleportacja.
ent-ClothingOuterSuitChicken = kombinezon chicken
    .desc = Ko ko ko!
ent-ClothingOuterSuitShrineMaiden = strój kapłanki shinto
    .desc = Aż chce się iść ogarnąć kłopotliwe youkai.
ent-ClothingOuterSuitWitchRobes = szaty wiedźmy
    .desc = Magia to przede wszystkim moc czaru, ZE!
ent-ClothingOuterSuitMonkey = kombinezon monkey
    .desc = Kombinezon wyglądający jak naczelny.
ent-ClothingOuterSuitIan = kombinezon IAN
    .desc = Kto tu jest grzecznym pieskiem?
ent-ClothingOuterSuitCarp = kombinezon CARP
    .desc = Specjalny kombinezon, przez który wyglądasz jak kosmiczny karp, jeśli masz słaby wzrok.
ent-ClothingOuterHardsuitCarp = { ent-ClothingOuterSuitCarp }
