ent-ClothingHeadHelmetBase = { ent-ClothingHeadBase }
    .desc = { ent-ClothingHeadBase.desc }
ent-ClothingHeadHelmetArmoredBase = { ent-ClothingHeadHelmetBase }
    .desc = { ent-ClothingHeadHelmetBase.desc }
ent-ClothingHeadHelmetBasic = hełm ochrony
    .desc = Standard Ochrona gear. Protects the head from impacts.
ent-ClothingHeadHelmetMerc = hełm najemnika
    .desc = Hełm bojowy powszechnie używany przez najemników, mocny, lekki, pachnie prochem i dżunglą.
ent-ClothingHeadHelmetSwat = hełm SWAT
    .desc = Niezwykle solidny hełm, powszechnie używany przez siły paramilitarne. Ten ma logo Nanotrasen na czubku.
ent-ClothingHeadHelmetSwatSyndicate = hełm SWAT
    .desc = Niezwykle solidny hełm, powszechnie używany przez siły paramilitarne. Ozdobiony nikczemnym czerwono-czarnym wzorem w paski.
    .suffix = Syndykat
ent-ClothingHeadHelmetRiot = lekki hełm do tłumienia zamieszek
    .desc = Hełm zaprojektowany specjalnie do ochrony przed atakami z bliska.
ent-ClothingHeadHelmetBombSuit = hełm kombinezonu przeciwwybuchowego
    .desc = Ciężki hełm zaprojektowany, by wytrzymać ciśnienie wybuchu bomby i odłamki.
ent-ClothingHeadHelmetJanitorBombSuit = hełm kombinezonu przeciwwybuchowego woźnego
    .desc = Ciężki hełm zaprojektowany, by wytrzymać wybuchy z reakcji chemicznych.
ent-ClothingHeadHelmetCult = hełm kultu
    .desc = Solidny, złowieszczo wyglądający hełm kultu.
ent-ClothingHeadHelmetSpaceNinja = hełm kosmicznego ninja
    .desc = To, co wygląda na prosty czarny ubiór, jest w istocie wyrafinowanym hełmem z nanotkaniny. Standardowy sprzęt ninja.
ent-ClothingHeadHelmetTemplar = hełm rycerski
    .desc = Dekoracyjny hełm wzorowany na rycerzach z dawnych czasów.
ent-ClothingHeadHelmetThunderdome = hełm thunderdome
    .desc = Niech rozpocznie się bitwa!
ent-ClothingHeadHelmetWizardHelm = hełm czarodzieja
    .desc = Dziwnie wyglądający hełm, który z pewnością należy do prawdziwego użytkownika magii.
ent-ClothingHeadHelmetFire = hełm strażacki
    .desc = Najlepszy przyjaciel technika atmosferyki. Daje trochę odporności na ciepło i wygląda cool.
ent-ClothingHeadHelmetAtmosFire = hełm strażacki atmosferyczny
    .desc = Hełm strażacki atmosferyczny, potrafi utrzymać noszącego w chłodzie w każdej sytuacji.
ent-ClothingHeadHelmetLing = hełm chitynowy
    .desc = Wszystkożerna chitynowa masa pancerza.
ent-ClothingHeadHelmetERTLeader = hełm lidera JSR
    .desc = Hełm do użytku w atmosferze noszony przez lidera Jednostki Szybkiego Reagowania Nanotrasen. Ma niebieskie akcenty.
ent-ClothingHeadHelmetERTSecurity = hełm ochrony JSR
    .desc = Hełm do użytku w atmosferze noszony przez członków ochrony Jednostki Szybkiego Reagowania Nanotrasen. Ma czerwone akcenty.
ent-ClothingHeadHelmetERTMedic = hełm medyka JSR
    .desc = Hełm do użytku w atmosferze noszony przez członków medycznych Jednostki Szybkiego Reagowania Nanotrasen. Ma białe akcenty.
ent-ClothingHeadHelmetERTEngineer = hełm inżyniera JSR
    .desc = Hełm do użytku w atmosferze noszony przez członków inżynieryjnych Jednostki Szybkiego Reagowania Nanotrasen. Ma pomarańczowe akcenty.
ent-ClothingHeadHelmetERTJanitor = hełm sprzątacza JSR
    .desc = Hełm do użytku w atmosferze noszony przez sprzątaczy Jednostki Szybkiego Reagowania Nanotrasen. Ma ciemno-fioletowe akcenty.
ent-ClothingHeadHelmetRaid = hełm szturmowy syndykatu
    .desc = Opancerzony hełm do użytku z kombinezonem szturmowym Syndykatu. Bardzo stylowy.
ent-ClothingHeadHelmetBone = hełm z kości
    .desc = Fajnie wyglądający hełm z czaszki twoich wrogów.
ent-ClothingHeadHelmetPodWars = hełm ironclad II
    .desc = Hełm ironclad II, relikt wojen podów.
ent-ClothingHeadHelmetJustice = hełm sprawiedliwości
    .desc = Zaawansowany sprzęt ochrony. Chroni stację przed łotrami.
ent-ClothingHeadHelmetJusticeEmpty = { ent-ClothingHeadHelmetJustice }
    .suffix = Puste
    .desc = { ent-ClothingHeadHelmetJustice.desc }
ent-ActionToggleJusticeHelm = przełącz hełm sprawiedliwości
    .desc = Włącza i wyłącza hełm sprawiedliwości.
ent-CardHelmet = tekturowy hełm
    .desc = Średniowieczny hełm z tektury.
