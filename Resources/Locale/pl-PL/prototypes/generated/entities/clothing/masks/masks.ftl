ent-ClothingMaskGas = maska przeciwgazowa
    .desc = Maska zakrywająca twarz, którą można podłączyć do dopływu powietrza.
ent-ClothingMaskGasSecurity = maska przeciwgazowa ochrony
    .desc = Standardowa maska przeciwgazowa dla oficerów ochrony.
ent-ClothingMaskGasSyndicate = maska przeciwgazowa syndykatu
    .desc = Przylegająca taktyczna maska, którą można podłączyć do dopływu powietrza.
ent-ClothingMaskGasAtmos = maska przeciwgazowa technika atmosferycznego
    .desc = Ulepszona maska przeciwgazowa dla techników atmosferycznych. Jest ognioodporna!
ent-ClothingMaskGasCaptain = maska przeciwgazowa kapitana
