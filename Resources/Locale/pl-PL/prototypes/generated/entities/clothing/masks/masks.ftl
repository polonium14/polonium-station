ent-ClothingMaskFox = maska lisa
    .desc = Co mówi lis?
ent-ClothingMaskBee = maska pszczoły
    .desc = Za królową!
ent-ClothingMaskBear = maska niedźwiedzia
    .desc = Kłapouszek czy Kubuś Puchatek?
ent-ClothingMaskRaven = maska kruka
