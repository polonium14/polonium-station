ent-PowerCellPotato = bateria ziemniaczana
    .desc = Ktoś włożył dwa gwoździe i trochę drutu w dużego ziemniaka. W jakiś sposób zapewnia trochę energii.
ent-PowerCellSmall = bateria o małej pojemności
    .desc = Ładowalna bateria. To najtańszy rodzaj, jaki można znaleźć.
    .suffix = Pełna
ent-PowerCellMedium = bateria o średniej pojemności
    .desc = Ładowalna bateria. To popularna i niezawodna wersja.
    .suffix = Pełna
ent-PowerCellHigh = bateria o dużej pojemności
    .desc = Ładowalna bateria. Ta premium marka przechowuje do 50% więcej energii niż konkurencja.
    .suffix = Pełna
ent-PowerCellHyper = bateria o hiperpojemności
    .desc = Ładowalna, standardowa bateria. Ta wygląda jak rzadki i potężny prototyp.
    .suffix = Pełna
ent-PowerCellMicroreactor = bateria mikroreaktorowa
    .desc = Ładowalna, standardowa bateria mikroreaktorowa. Ma mniejszą pojemność, ale powoli się samoczynnie ładuje.
    .suffix = Pełna
ent-PowerCellAntiqueProto = prototyp antycznej baterii
    .desc = Mała bateria, która samoczynnie się ładuje. Używana w badaniach nad starymi ramionami laserowymi.
ent-PowerCageSmall = mała bateria klatkowa
    .desc = Ładowalna bateria klatkowa do dużych urządzeń. To najtańszy rodzaj, jaki można znaleźć.
ent-PowerCageMedium = średnia bateria klatkowa
    .desc = Ładowalna bateria klatkowa do dużych urządzeń. Złoty standard pojemności i kosztów.
ent-PowerCageHigh = duża bateria klatkowa
    .desc = Ładowalna bateria klatkowa do dużych urządzeń. Zwiększona pojemność dla wyższych poziomów mocy.
ent-PowerCellMediumSingle = bateria jednorazowa o średniej pojemności
    .desc = Nieładowalna bateria. To popularna i tania wersja. Bateria nie jest warta czasu, jaki zajmuje jej wyrzucenie.
    .suffix = Pełna, Jednorazowa
ent-PowerCellHighSingle = bateria jednorazowa o dużej pojemności
    .desc = Nieładowalna, standardowa bateria. Ta substandardowa marka przechowuje do 50% więcej energii niż konkurencja, z zastosowaniem środków oszczędnościowych.
    .suffix = Pełna, Jednorazowa
ent-PowerCellHyperSingle = bateria jednorazowa o hiperpojemności
    .desc = Nieładowalna, standardowa bateria. Ta wygląda jak imitacja prototypu.
    .suffix = Pełna, Jednorazowa
