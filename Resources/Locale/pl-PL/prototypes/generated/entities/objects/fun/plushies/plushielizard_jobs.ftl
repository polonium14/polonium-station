ent-BasePlushieLizardJob = { ent-PlushieLizard }
    .desc = { ent-PlushieLizard.desc }
ent-PlushieLizardJobAtmospherictechnician = pluszak jaszczurki-technika atmosferyki
    .desc = Urocza pluszowa zabawka przypominająca osobę-jaszczurkę w stroju Technika Atmosferyki. Pachnie delikatnie frezonem.
ent-PlushieLizardJobBartender = pluszak jaszczurki-barmana
    .desc = Urocza pluszowa zabawka przedstawiająca postać jaszczuroczłowieka w roli Barmana. Na jej języku widać plamy po alkoholu.
ent-PlushieLizardJobBotanist = pluszak jaszczurki-botanika
    .desc = Urocza pluszowa zabawka przypominająca jaszczuroczłeka w stroju Botanika. Na łapkach ma kolczaste wypustki i delikatnie pachnie nawozem do roślin.
ent-PlushieLizardJobBoxer = pluszak jaszczurki-boksera
    .desc = Urocza pluszowa zabawka przedstawiająca postać jaszczuroczłowieka w stroju bokserskim. Sznurówki na jej rękawicach zaczynają się rozplatać.
ent-PlushieLizardJobCaptain = pluszak jaszczurki-kapitana
    .desc = Urocza pluszowa zabawka przedstawiająca Kapitana w postaci człowieka-jaszczurki. Na twarzy ma resztki ciasta.
ent-PlushieLizardJobCargotechnician = pluszak jaszczurki-logistyka
    .desc = Urocza pluszowa zabawka przypominająca postać jaszczuroczłowieka pracującą jako logistyk. Do jej łusek przykleiły się okruchy wypełniacza z pianki.
ent-PlushieLizardJobChaplain = pluszak jaszczurki-kapłana
    .desc = Urocza pluszowa zabawka przypominająca postać jaszczuroczłowieka pełniącą funkcję Kapłana. Czuć od niej delikatny zapach kadzidła.
ent-PlushieLizardJobChef = pluszak jaszczurki-kucharza
    .desc = Urocza pluszowa zabawka przypominająca postać jaszczuroczłeka w stroju Kucharza. Pachnie delikatnie przyprawami, a na jej fartuchu widać plamki oleju.
ent-PlushieLizardJobChemist = pluszak jaszczurki-chemika
    .desc = Urocza pluszowa zabawka przedstawiająca postać jaszczuroczłowieka w stroju Chemika. Niektóre części pluszaka są poplamione substancjami chemicznymi.
ent-PlushieLizardJobChiefengineer = pluszak jaszczurki-głównego inżyniera
    .desc = Urocza pluszowa zabawka przedstawiająca osobę-jaszczurkę pełniącą funkcję Głównego Inżyniera. Jest pokryta wiórami metalowymi i rozpryskami spawalniczymi.
ent-PlushieLizardJobChiefmedicalofficer = pluszak jaszczurki-ordynatora
    .desc = Urocza pluszowa zabawka przedstawiająca postać z gatunku jaszczuroludzi pełniącą funkcję ordynatora. Ogon pluszaka został odcięty i ponownie przyszyty, prawdopodobnie w wyniku ćwiczeń chirurgicznych.
ent-PlushieLizardJobClown = pluszak jaszczurki-klauna
    .desc = Urocza pluszowa zabawka przedstawiająca postać jaszczuroczłowieka w stroju Klauna. Po naciśnięciu nosa wydaje pisk.
ent-PlushieLizardJobDetective = pluszak jaszczurki-detektywa
    .desc = Urocza pluszowa zabawka przypominająca postać jaszczuroczłowieka w roli Detektywa. Wygląda na gotową do rozwiązania zagadki.
ent-PlushieLizardJobHeadofpersonnel = pluszak jaszczurki-kierownika personelu
    .desc = Urocza pluszowa zabawka przypominająca postać jaszczuroczłowieka pełniącą funkcję Kierownika Personelu. Choć na pozór wydaje się zachwycona, prawdopodobnie nudzi się tak samo jak ty.
ent-PlushieLizardJobHeadofsecurity = pluszak jaszczurki-komendanta
    .desc = Urocza pluszowa zabawka przypominająca postać jaszczuroczłowieka pełniącą funkcję Komendanta ochrony. Wygląda na to, że była kilkakrotnie rozcinana i ponownie zszywana.
ent-PlushieLizardJobJanitor = pluszak jaszczurki-woźnego
    .desc = Urocza pluszowa zabawka przypominająca osobę-jaszczurkę w stroju woźnego. Pachnie delikatnie środkami czystości.
ent-PlushieLizardJobLawyer = pluszak jaszczurki-prawnika
    .desc = Urocza pluszowa zabawka przedstawiająca jaszczuroczłeka w stroju prawnika. Jego przypinka z symbolem prawnika ledwo się trzyma po wielu godzinach wiercenia się.
ent-PlushieLizardJobLibrarian = pluszak jaszczurki-bibliotekarza
    .desc = Urocza pluszowa zabawka przedstawiająca postać jaszczuroczłowieka w stroju Bibliotekarza. Kolor pluszaka wyblakł po latach spędzonych na biurku.
ent-PlushieLizardJobMedicaldoctor = pluszak jaszczurki-doktora medycznego
    .desc = Urocza pluszowa zabawka przedstawiająca postać jaszczuroczłowieka w stroju Doktora Medycznego. Wygląda na to, że została dobrze wyprana.
ent-PlushieLizardJobMedicalintern = pluszak jaszczurki-stażysty medycznego
    .desc = Urocza pluszowa zabawka przypominająca postać jaszczuroczłowieka w stroju Stażysty Medycznego. Czuć od niej delikatny zapach środka antyseptycznego.
ent-PlushieLizardJobMime = pluszak jaszczurki-mima
    .desc = Urocza pluszowa zabawka przypominająca postać jaszczuroczłowieka w roli Mim. Wpatruje się w ciebie w milczeniu, a jej intencje pozostają nieznane.
ent-PlushieLizardJobMusician = pluszak jaszczurki-muzyka
    .desc = Urocza pluszowa zabawka przypominająca muzyka o wyglądzie jaszczuroczłowieka. Pachnie delikatnie potem i ma kilka poluzowanych sznurków.
ent-PlushieLizardJobParamedic = pluszak jaszczurki-ratownika
    .desc = Urocza pluszowa zabawka przedstawiająca postać z gatunku jaszczuroludzi w stroju Ratownika. Na pluszaku przyszyto kilka małych bandaży.
ent-PlushieLizardJobPassenger = pluszak jaszczurki-pasażera
    .desc = Urocza pluszowa zabawka przypominająca osobę-jaszczurkę w roli pasażera. Jej oczy patrzą na ciebie, odrobinę bardziej paciorkowate niż u reszty.
ent-PlushieLizardJobPsychologist = pluszak jaszczurki-psychologa
    .desc = Urocza pluszowa zabawka przedstawiająca postać jaszczuroczłowieka w roli Psychologa. Wygląda na to, że lubi cię po cichu słuchać.
ent-PlushieLizardJobQuartermaster = pluszak jaszczurki-kwatermistrza
    .desc = Urocza pluszowa zabawka przedstawiająca osobę-jaszczurkę pełniącą funkcję Kwatermistrza. Jest pokryta lepką warstwą pozostałości po tysiącach faktur wysyłkowych.
ent-PlushieLizardJobReporter = pluszak jaszczurki-dziennikarza
    .desc = Urocza pluszowa zabawka przypominająca dziennikarza-jaszczuroczłeka. Czuć od niej delikatny zapach atramentu.
ent-PlushieLizardJobResearchassistant = pluszak jaszczurki-asystenta naukowego
    .desc = Urocza pluszowa zabawka przypominająca jaszczuroczłowieka pełniącego rolę Asystenta Naukowego. Pachnie delikatnie spalonym papierem.
ent-PlushieLizardJobResearchdirector = pluszak jaszczurki-kierownika badań
    .desc = Urocza pluszowa zabawka przedstawiająca osobę-jaszczurkę pełniącą funkcję Kierownika Badań. Na pluszaku widać kilka śladów przypalenia.
ent-PlushieLizardJobSalvagespecialist = pluszak jaszczurki-specjalisty ds. odzysku
    .desc = Urocza pluszowa zabawka przypominająca postać jaszczuroczłeka, który jest Specjalistą ds. Odzysku. Wygląda na to, że już od jakiegoś czasu doświadcza chłodu kosmosu.
ent-PlushieLizardJobScientist = pluszak jaszczurki-naukowca
    .desc = Urocza pluszowa zabawka przedstawiająca naukowca o wyglądzie jaszczuroczłowieka. Na pluszaku widać kilka śladów ugryzień, prawdopodobnie pozostawionych przez ciekawską małpkę.
ent-PlushieLizardJobSecuritycadet = pluszak jaszczurki-kadeta ochrony
    .desc = Urocza pluszowa zabawka przypominająca postać jaszczuroczłowieka w mundurze Kadeta Ochrony. Na pluszaku widać ślady po porażeniu prądem.
ent-PlushieLizardJobSecurityofficer = pluszak jaszczurki-oficera ochrony
    .desc = Urocza pluszowa zabawka przypominająca postać jaszczuroczłowieka pełniącą funkcję Oficera Ochrony. Wypełnienie jest nieco spłaszczone w wyniku licznych uderzeń.
ent-PlushieLizardJobServiceworker = pluszak jaszczurki-pracownika serwisu
    .desc = Urocza pluszowa zabawka przypominająca postać jaszczuroczłeka pracownika Serwisu. Pachnie mieszanką środków czystości i jedzenia.
ent-PlushieLizardJobStationengineer = pluszak jaszczurki-inżyniera stacji
    .desc = Urocza pluszowa zabawka przypominająca postać jaszczuroczłeka w stroju Inżyniera Stacji. Ma plamy oleju na rękach.
ent-PlushieLizardJobTechnicalassistant = pluszak jaszczurki-pomocnika technicznego
    .desc = Urocza pluszowa zabawka przypominająca postać jaszczuroczłowieka pełniącą rolę Pomocnika Technicznego. Czuć od niej delikatny zapach spalonych przewodów.
ent-PlushieLizardJobWarden = pluszak jaszczurki-nadzorcy ochrony
    .desc = Urocza pluszowa zabawka przedstawiająca postać jaszczuroczłeka pełniącą funkcję Nadzorcza Ochrony. Pachnie prochem strzelniczym i olejem do broni.
ent-PlushieLizardJobZookeeper = pluszak jaszczurki-zoologa
    .desc = Urocza pluszowa zabawka przedstawiająca postać jaszczuroczłowieka w roli opiekuna w zoo. Ma na sobie kilka kłębków sierści goryla.
ent-PlushieLizardJobMultiweh = pluszak jaszczurki Multiweh
    .desc = Urocza pluszowa zabawka, która przypomina osobę-jaszczurkę w każdym zawodzie! To pluszak o wielu talentach. W oddali słychać płacz KP.
