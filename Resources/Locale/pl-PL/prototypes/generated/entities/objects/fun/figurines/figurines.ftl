ent-BaseFigurine = figurka
    .desc = Mała miniatura.
ent-ToyFigurineHeadOfPersonnel = dane dotyczące liczby pracowników
    .desc = Figurka przedstawiająca czcigodnego Kierownika Personelu, który jak zwykle przebywa poza biurem.
ent-ToyFigurinePassenger = liczba pasażerów
    .desc = Figurka przedstawiająca zwykłego, przeciętnego pasażera. Żadnych dziwactw.
ent-ToyFigurineGreytider = figurka Greytidera
    .desc = Figurka przedstawiająca podejrzanie wyglądającego pasażera. Greytide na całym świecie!
ent-ToyFigurineClown = postać Klauna
    .desc = Figurka przedstawiająca Klauna. Aż ciarki przechodzą na samą myśl o tym, co ludzie prawdopodobnie zrobili z tą figurką wcześniej.
ent-ToyFigurineHoloClown = figurka holoklovna
    .desc = Figurka przedstawiająca holoklauna. Jeszcze bardziej irytująca niż Klaun, a nie mniej prawdziwa.
ent-ToyFigurineMime = postać pantomimiczna
    .desc = Figurka przedstawiająca tego milczącego drania, którego wszyscy zbyt dobrze znacie.
ent-ToyFigurineMusician = postać Muzyk
    .desc = Figurka przedstawiająca Muzyka – jego muzyka porywała do tańca.
ent-ToyFigurineBoxer = sylwetka boksera
    .desc = Figurka przedstawiająca boksera trzymającego swoje czerwone rękawice.
ent-ToyFigurineCaptain = postać kapitana
    .desc = Figurka przedstawiająca standardowy strój Kapitana statku firmy Nanotrasen z sektora cywilnego.
ent-ToyFigurineHeadOfSecurity = Komendant służb ochrony
    .desc = Figurka przedstawiająca szanowanego komendanta wydziału ochrony.
ent-ToyFigurineWarden = postać nadzorcza ochrony
    .desc = Figurka przedstawiająca Nadzorcę Ochrony, gotowego w każdej chwili wsadzić kogoś do więzienia.
ent-ToyFigurineDetective = postać detektywa
    .desc = Figurka przedstawiająca detektywa w jego charakterystycznym trenczu.
ent-ToyFigurineSecurity = postać oficera ochrony
    .desc = Figurka przedstawiająca Oficera Ochrony trzymającego pałkę elektryczną, gotowego do obrony stacji.
ent-ToyFigurineLawyer = postać prawnika
    .desc = Figurka przedstawiająca prawnika ubranego w świeżo uszyty garnitur.
ent-ToyFigurineCargoTech = ilustracja przedstawiająca technika ds. logistyki ładunków
    .desc = Figurka przedstawiająca technika z dziedziny logistyki o wyglądzie gada.
ent-ToyFigurineSalvage = dane dotyczące Specjalisty ds. Odzysku
    .desc = Figurka przedstawiająca Specjalistę ds. Odzysku trzymającego nóż survivalowy.
ent-ToyFigurineQuartermaster = postać Kwatermistrza
    .desc = Figurka przedstawiająca szanowanego szefa działu Logistyki.
ent-ToyFigurineChiefEngineer = postać Głównego Inżyniera
    .desc = Figurka przedstawiająca szanowanego kierownika wydziału inżynieryjnego.
ent-ToyFigurineEngineer = postać Inżyniera Stacji
    .desc = Figurka przedstawiająca Inżyniera Stacji trzymającego łom w pozycji gotowości.
ent-ToyFigurineAtmosTech = ilustracja przedstawiająca Technik Atmosferyki
    .desc = Figurka przedstawiająca pracownika firmy Atmos Tech trzymającego nieodpaloną spawarkę.
ent-ToyFigurineResearchDirector = dane dotyczące Kierownika Badań
    .desc = Figurka przedstawiająca szanowanego kierownika wydziału Badania i Rozwój.
ent-ToyFigurineScientist = figurka naukowca
    .desc = Figurka przedstawiająca naukowca w fartuchu laboratoryjnym.
ent-ToyFigurineChiefMedicalOfficer = dane dotyczące ordynatora
    .desc = Figurka przedstawiająca wybitnego kierownika oddziału medycznego.
ent-ToyFigurineChemist = postać Chemika
    .desc = Figurka przedstawiająca Chemika, który prawdopodobnie zamierza wyprodukować metamfetaminę.
ent-ToyFigurineParamedic = postać ratownika medycznego
    .desc = Figurka przedstawiająca ratownika medycznego w kombinezonie próżniowym.
ent-ToyFigurineMedicalDoctor = postać Doktora Medycznego
    .desc = Figurka przedstawiająca Doktora Medycznego w fartuchu laboratoryjnym z strzykawką.
ent-ToyFigurineLibrarian = postać bibliotekarza
    .desc = Figurka przedstawiająca jedynego w swoim rodzaju Bibliotekarza.
ent-ToyFigurineChaplain = postać Kapłana
    .desc = Figurka przedstawiająca Kapłana modlącego się z nadzieją o dobre rzeczy.
ent-ToyFigurineChef = postać kucharza
    .desc = Figurka przedstawiająca kucharza, mistrza sztuki kulinarnej!… przynajmniej w większości przypadków.
ent-ToyFigurineBartender = postać barmana
    .desc = Figurka przedstawiająca barmana w stylowym stroju, z modnymi okularami przeciwsłonecznymi i cylindrem.
ent-ToyFigurineBotanist = postać Botanika
    .desc = Figurka przedstawiająca Botanika, który z pewnością nie pozwoli, by kudzu rozrosło się poza kontrolę.
ent-ToyFigurineJanitor = postać woźnego
    .desc = Figurka przedstawiająca woźnego w kaloszach.
ent-ToyFigurineNukie = osoba pełniąca funkcję operacyjną w Syndykatie
    .desc = Figurka przedstawiająca postać w krwistoczerwonym kombinezonie, podobnym do tego, jaki noszą operatorzy nukleiarni.
ent-ToyFigurineNukieElite = członek elitarnego Syndykatu przestępczego
    .desc = Figurka przedstawiająca postać w elitarnym, krwistoczerwonym kombinezonie, podobnym do tego, jaki noszą Operatorzy nukleiarni.
ent-ToyFigurineNukieCommander = postać dowódcy operacyjnego Syndykatu
    .desc = Figurka przedstawiająca postać w wzmocnionym, krwistoczerwonym kombinezonie bojowym, podobnym do tego, jaki mógłby nosić dowódca zespołu operatorów nuklearnych.
ent-ToyFigurineFootsoldier = postać szeregowego członka Syndykatu
    .desc = Figurka przedstawiająca strój szeregowego członka Syndykatu.
ent-ToyFigurineWizard = postać Czarodzieja
    .desc = Figurka przedstawiająca postać z długą, jedwabistą brodą, ubraną w strój Czarodzieja. Czarownicy mogliby tylko pomarzyć o czymś takim.
ent-ToyFigurineWizardFake = figurka fałszywego czarodzieja
    .desc = Figurka przedstawiająca kogoś w kiczowatym kostiumie czarodzieja. Co za oszustwo!
ent-ToyFigurineGriffin = figura gryfa
    .desc = Figurka przedstawiająca „Gryfa”, geniusza przestępczego.
ent-ToyFigurineOwlman = figurka człowieka-sowy
    .desc = Figurka przedstawiająca „Owlmana”, obrońcę sprawiedliwości.
ent-ToyFigurineSkeleton = postacie szkieletowe
    .desc = Figurka przedstawiająca upiornego, przerażającego szkieleta.
ent-ToyFigurineThief = Złodziej character figure
    .desc = Hiding in the shadows...
ent-ToyNuke = zabawka w kształcie bomby atomowej
    .desc = Plastikowy model ładunku wybuchowego opartego na rozszczepieniu jądrowym. Nie zawiera uranu… prawdopodobnie.
ent-ToyFigurineSpaceDragon = figurka Smoka kosmicznego
    .desc = Duża figurka przedstawiająca Smoka kosmicznego, którego czerwone oczy wpatrują się w ofiarę.
ent-ToyFigurineQueen = figurka królowej Xeno
    .desc = Duża figurka przedstawiająca królową Xeno, gotową do ataku.
ent-ToyFigurineRatKing = figurka króla szczurów
    .desc = Duża figurka przedstawiająca króla szczurów, gotowego do zbudowania gniazda.
ent-ToyFigurineRatServant = figurka szczura-sługi
    .desc = Figurka przedstawiająca szczura służącego królowi szczurów!
ent-ToyFigurineMouse = rysunek myszy
    .desc = Figurka przedstawiająca mysz pędzącą w kierunku najbliższego kawałka jedzenia.
ent-ToyFigurineSlime = figurka z szlamu
    .desc = Figurka przedstawiająca półprzezroczystego niebieskiego szlama.
ent-ToyFigurineHamlet = postać z „Hamleta”
    .desc = Figurka przedstawiająca Hamleta; mikrofalówka nie wchodzi w skład zestawu.
ent-ToyAi = Zabawka z SI
    .desc = Zredukowany rdzeń SI w wersji zabawkowej.
