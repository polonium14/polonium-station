ent-BasePlushie = { ent-SolutionFood }
    .desc = { ent-SolutionFood.desc }
ent-PlushieThrongler = pluszowa zabawka „Throngler”
    .desc = Pluszak, który ma przypominać technikom ds. logistyki o tym, czego już nie mogą mieć.
ent-PlushieGhost = pluszowa zabawka w kształcie ducha
    .desc = Początek Twojej własnej grupy GHOST GANG!
ent-PlushieGhostRevenant = pluszowa zabawka „Revenant”
    .desc = Jest tak miękki, że aż chce się zdrzemnąć...
ent-PlushieBee = pluszowa pszczółka
    .desc = Urocza zabawka, która przypomina jeszcze bardziej uroczego programistę. Trzeba by być potworem, żeby to zmiażdżyć.
ent-PlushieHampter = pluszowa zabawka Hampter
    .desc = Urocza pluszowa zabawka przypominająca chomika. Ma nieco spłaszczoną twarz.
ent-PlushieRGBee = Pluszak RGBee
    .desc = Urocza zabawka, która po zażyciu LSD przypomina pluszową pszczółkę.
ent-PlushieNuke = pluszak nukie
    .desc = Pluszak przypominający Operatora nuklearnego z Syndykatu. Na metce zaznaczono, że postacie te są czysto fikcyjne.
ent-PlushieRouny = okrągła pluszowa zabawka
    .desc = Rouny.
ent-PlushieLamp = pluszowa lampka
    .desc = Świecący przyjaciel!
ent-PlushieArachind = pluszowa zabawka w kształcie pajęczaka
    .desc = Urocza pluszowa zabawka przypominająca pajęczaka. W dotyku jest jedwabista...
ent-PlushieLizard = pluszowa jaszczurka
    .desc = Urocza pluszowa zabawka przypominająca osobę-jaszczurkę. Wyprodukowana przez firmę CD w ramach symbolicznej inicjatywy mającej na celu walkę ze specyzizmem w środowisku pracy. „Powitaj swoich nowych współpracowników tak samo, jak tę pluszową zabawkę – z otwartymi ramionami!”
ent-PlushieExperiment = pluszak eksperymentalny
    .desc = A plushie of a canid of sorts, it yearns to be detonated on a landmine.
ent-PlushieRainbowLizard = pluszowa jaszczurka tęczowa
    .desc = Urocza pluszowa zabawka przypominająca jaszczuroczłowieka w różnych kolorach. Patrząc na nią, można się potknąć...
ent-PlushieLizardMirrored = { ent-PlushieLizard }
    .suffix = Lustrzane odbicie
    .desc = { ent-PlushieLizard.desc }
ent-PlushieSpaceLizard = pluszowa jaszczurka kosmiczna
    .desc = An adorable stuffed toy that resembles a lizardperson in an EVA suit. Made by CD as a token initiative to combat speciesism in space environments. "Welcome your new colleges as you do this plush, with open arms!"
ent-PlushieLizardInversed = pluszowa zabawka Drazil
    .desc = Urocza pluszowa zabawka przypominająca jaszczuroczłeka z odwróconego wymiaru. Hew!
ent-PlushieDiona = pluszowa zabawka Diona
    .desc = Urocza pluszowa zabawka przypominająca dionę. Uwielbia wodę i przytulanie. Nie moczyć!
ent-PlushieSharkBlue = pluszowa zabawka w kształcie żarłacza błękitnego
    .desc = Duży i niezawodny towarzysz, jeśli chcesz odkrywać świat pod powierzchnią oceanu.
ent-PlushieSharkPink = pluszowa zabawka w kształcie różowego rekina
    .desc = Hehe, shonk :)
ent-PlushieSharkGrey = pluszowa zabawka w kształcie szarego rekina
    .desc = Cichy, powściągliwy typ oszusta. Uwielbia płynąć na fali szarości.
ent-PlushieRatvar = pluszak Ratvar
    .desc = A small stuffed doll of the elder god Ratvar.
ent-PlushieNar = pluszak Nar'Sie
    .desc = A small stuffed doll of the elder goddess Nar'Sie.
ent-PlushieCarp = pluszowa karpia
    .desc = Urocza pluszowa zabawka przypominająca potworną kosmiczną karpię.
ent-PlushieMagicarp = pluszowa zabawka Magicarp
    .desc = Urocza pluszowa zabawka przypominająca niezwykle rzadkiego Magicarpa.
ent-PlushieRainbowCarp = pluszowa karpia tęczowa
    .desc = Urocza pluszowa zabawka przypominająca legendarnego tęczowego karpia.
ent-PlushieHolocarp = pluszak Holocarp
    .desc = A holographic stuffed toy resembling Badania i Rozwój's nemesis — the holocarp.
ent-PlushieSlime = pluszowa zabawka w kształcie szlamu
    .desc = Urocza pluszowa zabawka przypominająca szlam. W zasadzie to po prostu hacky sack.
ent-PlushieSnake = pluszowy wąż
    .desc = Urocza pluszowa zabawka przypominająca węża.
ent-ToyMouse = zabawka w kształcie myszki
    .desc = Kolorowa myszka-zabawka!
ent-PlushieVox = pluszowa zabawka Vox
    .desc = SKREEEEEEEEEEEE!
ent-PlushieAtmosian = pluszak Atmosian
    .desc = Urocza pluszowa zabawka przypominająca dzielnego Atmosianina. Niestety, nie naprawi za ciebie tych spadków ciśnienia.
ent-PlushieXeno = pluszowa zabawka Xeno
    .desc = Urocza pluszowa zabawka przypominająca przerażającego ksenomorfa. Masz szczęście, że to tylko zabawka.
ent-PlushiePenguin = pluszowy pingwin
    .desc = A tak przy okazji, używam Arch!
ent-PlushieHuman = pluszowa figurka przedstawiająca człowieka
    .desc = Jest to filcowa pluszowa figurka przedstawiająca człowieka. Jakość wykonania jest bardzo niska. Człowiek jest nagi. Człowiek płacze. Człowiek krzyczy.
ent-PlushieMoth = pluszowa ćma
    .desc = Urocza i puszysta pluszowa ćma. Miłej zabawy, BZ!
ent-PlushieSheep = pluszowa owieczka
    .desc = Miękka, wełniana, pluszowa owieczka. 100% bawełna.
ent-PlushieSpaceSheep = pluszowa owca kosmiczna
    .desc = Miękka, wełniana owieczka z kosmicznym wypełnieniem. 100% bawełna.
ent-PlushieVulp = pluszowa zabawka „vulpkanin”
    .desc = Urocza pluszowa zabawka przypominająca vulpkanina. Yip! Yap!
ent-ToyIan = zabawka Iana
    .desc = Nie da się go zjeść, ale jest równie puszysty jak ten prawdziwy!
ent-ToyAmongPequeno = wśród „pequeño”
    .desc = Cicho!
