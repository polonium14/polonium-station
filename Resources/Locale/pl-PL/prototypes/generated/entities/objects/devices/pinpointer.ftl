ent-PinpointerBase = pinpointer
    .desc = Ręczne urządzenie śledzące. Chociaż zazwyczaj ma ono znacznie większe możliwości, to zostało skonfigurowane tak, aby namierzać określone sygnały. Trzymaj je w pozycji pionowej, aby zachować dokładność.
ent-PinpointerNuclear = pinpointer
    .desc = { ent-PinpointerBase.desc }
ent-PinpointerSyndicateNuclear = pinpointer syndykatu
    .desc = Wyprodukowane specjalnie do misji nuklearnych operatywów, zdobądź ten dysk!
ent-PinpointerUniversal = pinpointer uniwersalny
    .desc = Ręczne urządzenie śledzące, które blokuje się na dowolnym fizycznym obiekcie, gdy jest wyłączone. Trzymaj je w pozycji pionowej, aby zachować dokładność.
ent-PinpointerStation = pinpointer stacji
    .desc = Ręczne urządzenie śledzące, które prowadzi w kierunku dowolnej pobliskiej stacji.
    .suffix = Stacja
ent-PinpointerMothership = core pinpointer
    .desc = A handheld tracking device that leads to the direction of the Mothership core.
ent-PinpointerMothershipPiece = piece of core pinpointer
    .desc = A piece of a core pinpointer. You need four pieces to repair it.
ent-PinpointerMothershipRepaired = repaired core pinpointer
    .desc = A handheld tracking device that leads to the direction of the Mothership core. This one has seen better days.
