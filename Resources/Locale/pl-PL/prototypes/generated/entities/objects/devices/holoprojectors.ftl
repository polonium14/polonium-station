ent-Holoprojector = projektor holograficzny
    .desc = Poręczny projektor holograficzny, który wyświetla znak porządkowy.
ent-HoloprojectorEmpty = { ent-Holoprojector }
    .suffix = Pusty
    .desc = { ent-Holoprojector.desc }
ent-HoloprojectorBorg = projektor holosign
    .desc = Zmodyfikowany projektor holograficzny przeznaczony do stosowania w cyborgach porządkowych. Posiada funkcję automatycznego ładowania.
    .suffix = Borg
ent-HoloprojectorClownBorg = projektor Holopeel
    .desc = Projektor „Holopeel”, który tworzy śliską, twardą skórkę od banana ze światła. Urządzenie można ładować, dzięki czemu zabawa nigdy się nie kończy!
    .suffix = Borg
ent-HolofanProjector = projektor holowentylatorowy
    .desc = Powstrzymuje samobójczych pasażerów przed zabijaniem wszystkich podczas awarii atmosferycznych.
ent-HolofanProjectorEmpty = { ent-HolofanProjector }
    .suffix = Pusty
    .desc = { ent-HolofanProjector.desc }
ent-HolofanProjectorBorg = zintegrowany holofan
    .desc = Zapobiega sytuacji, w której idioci wyrządzają załogom dalsze szkody podczas sytuacji kryzysowych związanych z atmosferą. Urządzenie montuje się bezpośrednio w inżynieryjnym Cyborgu i ładuje się ono stopniowo z upływem czasu.
ent-HoloprojectorField = projektor pola siłowego
    .desc = Tworzy nieprzepuszczalne pole siłowe, które nie pozwala niczemu przejść. Bliska odległość może, ale nie musi powodować raka.
ent-HoloprojectorFieldEmpty = { ent-HoloprojectorField }
    .suffix = Pusty
    .desc = { ent-HoloprojectorField.desc }
ent-HoloprojectorSecurity = projektor holobariery
    .desc = Tworzy solidną, ale kruchą holograficzną barierę.
ent-HoloprojectorSecurityEmpty = { ent-HoloprojectorSecurity }
    .suffix = Pusty
    .desc = { ent-HoloprojectorSecurity.desc }
