ent-Holoprojector = projektor holograficzny
    .desc = Poręczny projektor holograficzny, który wyświetla znak porządkowy.
ent-HolofanProjector = projektor holowentylatorowy
    .desc = Powstrzymuje samobójczych pasażerów przed zabijaniem wszystkich podczas awarii atmosferycznych.
ent-HolofanProjectorRecharging = projektor holowentylatorowy
    .desc = Powstrzymuje samobójczych pasażerów przed zabijaniem wszystkich podczas awarii atmosferycznych. Posiada mikroreaktorową baterię, której nie należy wyjmować, ponieważ nie będziesz jej ponownie wkładać.
    .suffix = AutoRecharge
ent-HoloprojectorField = projektor pola siłowego
    .desc = Tworzy nieprzepuszczalne pole siłowe, które nie pozwala niczemu przejść. Bliska odległość może, ale nie musi powodować raka.
ent-HoloprojectorSecurity = projektor holobariery
    .desc = Tworzy solidną, ale kruchą holograficzną barierę.
