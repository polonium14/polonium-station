ent-BaseCargoPallet = paleta towarowa
    .desc = Podstawowy element logistyki przypominający o tym, gdzie skrzynie powinny się znaleźć podczas transportu, aby uniknąć posiniaczonych łydek.
ent-CargoPallet = { ent-BaseCargoPallet }
    .desc = { ent-BaseCargoPallet.desc }
ent-CargoPalletSell = paleta towarowa do sprzedaży
