ent-AnomalyScanner = skaner anomalii
    .desc = Ręczny skaner stworzony do zbierania informacji o różnych anomaliach.
ent-AnomalyLocatorUnpowered = lokalizator anomalii
    .desc = Urządzenie zaprojektowane do pomocy w lokalizowaniu anomalii. Sprawdziłeś górników gazu?
    .suffix = Bez zasilania
ent-AnomalyLocatorWideUnpowered = szerokopasmowy lokalizator anomalii
    .desc = Urządzenie, które szuka anomalii z większej odległości, ale nie potrafi określić ich odległości.
    .suffix = Bez zasilania
ent-WeaponGauntletGorilla = rękawica G.O.R.Y.L.
    .desc = Solidny kawałek sprzętu badawczego. Po zasileniu rdzeniem anomalii, pojedynczy cios może wystrzelić anomalne obiekty w powietrze.
