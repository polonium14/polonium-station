ent-BaseToolSurgery = { ent-BaseItem }
    .desc = { ent-BaseItem.desc }
ent-Cautery = kauter
    .desc = Narzędzie chirurgiczne do przyżegania otwartych ran.
ent-Drill = wiertło
    .desc = Wiertło chirurgiczne do robienia otworów w twardym materiale.
ent-Scalpel = skalpel
    .desc = Narzędzie chirurgiczne do nacinania tkanek.
ent-ScalpelShiv = szpikulec
    .desc = Ostrze ze szkła, obtarte na krawędź i owinięte taśmą jako uchwyt.
ent-ScalpelAdvanced = zaawansowany skalpel
    .desc = Z droższych materiałów, ostrzejszy i ogólnie pewniejszy.
ent-ScalpelLaser = skalpel laserowy
    .desc = Skalpel tnący skierowanym laserem zamiast ostrza. Precyzyjniejszy i przy okazji przyżega ranę.
ent-Retractor = rozwórka
    .desc = Narzędzie chirurgiczne do rozwierania nacięć.
ent-Hemostat = hemostat
    .desc = Narzędzie chirurgiczne do zaciskania naczyń krwionośnych, żeby zatamować krwawienie.
ent-Saw = piła metalowa
    .desc = Do cięcia drewna i innych rzeczy na kawałki. W razie potrzeby posłuży jako piła do kości.
ent-SawImprov = siekacz
    .desc = Nikczemne ząbkowane ostrze z czego się dało, byle ostre i paskudne.
ent-SawElectric = piła tarczowa
    .desc = Do ciężkiego cięcia.
ent-SawAdvanced = zaawansowana piła tarczowa
    .desc = Najnowocześniejsza piła do kości firmy Interdyne. Gwarantowana czystość i sterylność, niezależnie od tego, jak krwawa jest operacja.
