ent-BaseToolSurgery = { ent-BaseItem }
    .desc = { ent-BaseItem.desc }
ent-Cautery = { LOC("surgery-tool-name-cautery", przypadek: "mianownik") }
    .desc = Narzędzie chirurgiczne do przyżegania otwartych ran.
ent-Drill = { LOC("surgery-tool-name-drill", przypadek: "mianownik") }
    .desc = { CAPITALIZE(LOC("surgery-tool-name-drill", przypadek: "mianownik")) } chirurgiczne do robienia otworów w twardym materiale.
ent-Scalpel = { LOC("surgery-tool-name-scalpel", przypadek: "mianownik") }
    .desc = Narzędzie chirurgiczne do nacinania tkanek.
ent-ScalpelShiv = szpikulec
    .desc = Ostrze ze szkła, obtarte na krawędź i owinięte taśmą jako uchwyt.
ent-ScalpelAdvanced = zaawansowany { LOC("surgery-tool-name-scalpel", przypadek: "mianownik") }
    .desc = Z droższych materiałów, ostrzejszy i ogólnie pewniejszy.
ent-ScalpelLaser = { LOC("surgery-tool-name-scalpel", przypadek: "mianownik") } laserowy
    .desc = { CAPITALIZE(LOC("surgery-tool-name-scalpel", przypadek: "mianownik")) } tnący skierowanym laserem zamiast ostrza. Precyzyjniejszy i przy okazji przyżega ranę.
ent-Retractor = { LOC("surgery-tool-name-retractor", przypadek: "mianownik") }
    .desc = Narzędzie chirurgiczne do rozwierania nacięć.
ent-Hemostat = { LOC("surgery-tool-name-hemostat", przypadek: "mianownik") }
    .desc = Narzędzie chirurgiczne do zaciskania naczyń krwionośnych, żeby zatamować krwawienie.
ent-Saw = piła metalowa
    .desc = Do cięcia drewna i innych rzeczy na kawałki. W razie potrzeby posłuży jako { LOC("surgery-tool-name-bone-saw", przypadek: "mianownik") }.
ent-SawImprov = siekacz
    .desc = Nikczemne ząbkowane ostrze z czego się dało, byle ostre i paskudne.
ent-SawElectric = piła tarczowa
    .desc = Do ciężkiego cięcia.
ent-SawAdvanced = zaawansowana piła tarczowa
    .desc = Najnowocześniejsza { LOC("surgery-tool-name-bone-saw", przypadek: "mianownik") } firmy Interdyne. Gwarantowana czystość i sterylność, niezależnie od tego, jak krwawa jest operacja.
