ent-BaseHypoInjector = { ent-SolutionHypospraySmall }
    .desc = { ent-SolutionHypospraySmall.desc }
ent-BaseHypospray = { ent-BaseHypoInjector }
    .desc = { ent-BaseHypoInjector.desc }
ent-SolutionHypospraySmall = { ent-SolutionHypospray }
    .desc = { ent-SolutionHypospray.desc }
ent-SolutionHyposprayTiny = { ent-SolutionHypospray }
    .desc = { ent-SolutionHypospray.desc }
ent-Hypospray = hipospray
    .desc = Jałowy iniektor do szybkiego podawania leków pacjentom.
ent-SyndiHypo = hipospray Gorlex
    .desc = Using reverse engineered designs from NT, Cybersun produced these in limited quantities for Gorlex Marauder operatives.
ent-BorgHypo = borghipo
    .desc = A sterile injector for rapid administration of drugs to patients. A cheaper and more specialised version for Medyczny borgs.
ent-JetInjector = iniektor odrzutowy
    .desc = Jałowy iniektor do wygodnego podawania leków pacjentom.
ent-AdvancedJetInjector = zaawansowany iniektor odrzutowy
    .desc = Nienaganny, szykowny iniektor wysokiej jakości. Wstrzykuje szybciej i ma nieco większą pojemność.
ent-AdminHypo = eksperymentalny hipospray
    .desc = Najwyższe osiągnięcie technologii bluespace i szybkiego podawania chemikaliów.
    .suffix = Admeme
ent-ChemicalMedipen = medipen chemiczny
    .desc = A sterile injector for rapid administration of drugs to patients. This one can't be refilled.
ent-EmergencyMedipen = medipen ratunkowy
    .desc = A rapid and safe way to stabilize patients in critical condition for personnel without advanced Medyczny knowledge. Beware, as it's easy to overdose on epinephrine and tranexamic acid.
ent-AntiPoisonMedipen = autoinjektor na truciznę
    .desc = A rapid dose of anti-poison. Contains ultravasculine and epinephrine.
ent-BruteAutoInjector = autoinjektor na stłuczenia
    .desc = Jednorazowa dawka bikarydyny i kwasu traneksamowego, przeznaczona do szybkiego leczenia prostych urazów fizycznych. Często stosowana jako lek bojowy.
ent-BurnAutoInjector = autoinjektor na oparzenia
    .desc = Jednorazowa dawka dermaliny i leporazyny, przeznaczona do szybkiego leczenia oparzeń niechemicznych. Często stosowana jako lek bojowy.
ent-RadAutoInjector = autoinjektor na promieniowanie
    .desc = Jednorazowa dawka antypromiennej. Zawiera arytrazynę i bikarydynę.
ent-BoneAutoInjector = autoinjektor na kości
    .desc = Jednorazowa dawka osteodyny, przeznaczona do szybkiego leczenia złamanych kości.
ent-PunctAutoInjector = autoinjektor kłujorazyny
    .desc = Jednorazowa dawka kłujorazyny i kwasu traneksamowego, przeznaczona do szybkiego leczenia ran kłutych. Często stosowana jako lek bojowy.
ent-PyraAutoInjector = autoinjektor poparzyny
    .desc = Jednorazowa dawka poparzyny i dermaliny, przeznaczona do szybkiego leczenia oparzeń termicznych. Często stosowana jako lek bojowy.
ent-AirlossAutoInjector = autoinjektor na uduszenie
    .desc = Jednorazowa dawka soli fizjologicznej i deksaliny plus, przeznaczona do szybkiego leczenia utraty krwi i niedotlenienia.
ent-SpaceMedipen = medipen kosmiczny
    .desc = Contains a mix of chemicals that protect you from the deadly effects of space.
ent-SyndicateMedipen = { ent-SolutionToolSmall }
    .desc = { ent-SolutionToolSmall.desc }
ent-Stimpack = iniektor hiperzyny
    .desc = Contains enough hyperzine for you to have the chemical's effect for 30 seconds. Use it when you're sure you're ready to throw down.
ent-StimpackMini = mikroiniektor hiperzyny
    .desc = A microinjector of hyperzine that give you about 15 seconds of the chemical's effects.
ent-CombatMedipen = medipen bojowy
    .desc = A single-use medipen containing chemicals that regenerate most types of damage.
ent-Hypopen = { ent-Pen }
    .suffix = Hypopen
    .desc = { ent-Pen.desc }
ent-HypopenBox = pudełko hypopena
    .desc = Małe pudełko z hypopenem. Opakowanie rozpada się przy otwarciu i nie zostawia śladów.
ent-WehMedipenTiny = autoinjektor weh
    .desc = Jednorazowy medipen z dawką weh. Nie da się go uzupełnić.
ent-WehMedipen = autoinjektor weh
    .desc = A rapid dose of Weh. Contains juice that makes you Weh.
    .suffix = NIE MAPOWAĆ
