ent-BaseCartridgePistol = nabój (.35 auto)
    .desc = { ent-BaseCartridge.desc }
ent-CartridgePistol = nabój (.35 auto)
    .desc = Prawdopodobnie najpopularniejszy kaliber na rynku, stosowany w różnego rodzaju pistoletach i pistoletach maszynowych. Standardowa amunicja kinetyczna jest powszechnie dostępna i przydatna w większości sytuacji.
ent-CartridgePistolPractice = nabój (.35 auto treningowe)
    .desc = Prawdopodobnie najpopularniejszy kaliber na rynku, stosowany w różnego rodzaju pistoletach i pistoletach maszynowych. Amunicja treningowa wystrzeliwuje kredowy pocisk, który powoduje lekkie ukłucie, ale poza tym nie powoduje żadnych trwałych uszkodzeń.
ent-CartridgePistolIncendiary = nabój (.35 auto zapalające)
    .desc = Prawdopodobnie najpopularniejszy kaliber na rynku, stosowany w różnego rodzaju pistoletach i pistoletach maszynowych. Amunicja zapalająca zawiera związek samozapalający, który podpala cele.
ent-CartridgePistolUranium = nabój (.35 auto uranowe)
    .desc = Prawdopodobnie najpopularniejszy kaliber na rynku, stosowany w różnego rodzaju pistoletach i pistoletach maszynowych. Amunicja uranowa zastępuje ołówowy rdzeń pocisku materiałem rozszczepialnym, napromieniowując cele od wewnątrz.
ent-CartridgePistolSpent = nabój (.35 Auto)
    .suffix = wydane
    .desc = { ent-BaseCartridgePistol.desc }
