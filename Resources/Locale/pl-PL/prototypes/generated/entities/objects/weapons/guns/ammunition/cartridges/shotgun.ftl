ent-BaseShellShotgun = nabój (12 kaliber)
    .desc = { ent-BaseCartridge.desc }
ent-ShellShotgunBeanbag = nabój (12 kaliber traumatyczne)
    .desc = Standardowy nabój stosowany w większości nowoczesnych strzelb. Amunicja typu „beanbag” zawiera pojedynczy pocisk o działaniu nieśmiercionośnym, który może ogłuszyć cel.
ent-ShellShotgunSlug = nabój (12 kaliber jednolite)
    .desc = Standardowy nabój stosowany w większości współczesnych strzelb. Amunicja typu „slug” zawiera pojedynczy pocisk o dużej gęstości, skuteczny na większych odległościach niż amunicja śrutowa.
ent-ShellShotgunFlare = nabój (12 kaliber flarowe)
    .desc = Standardowy nabój stosowany w większości nowoczesnych strzelb. Amunicja sygnalizacyjna zawiera pojedynczy, jasno płonący pocisk przeznaczony raczej do oświetlania i sygnalizacji niż do celów bojowych.
ent-ShellShotgun = nabój (12 kaliber śruty)
    .desc = Standardowy nabój stosowany w większości nowoczesnych strzelb. Standardowa amunicja kinetyczna jest powszechnie dostępna i przydatna w większości sytuacji.
ent-ShellShotgunIncendiary = nabój (12 kaliber zapalające)
    .desc = Standardowy nabój stosowany w większości współczesnych strzelb. Amunicja zapalająca zawiera samozapalający się związek chemiczny, który podpala cele.
ent-ShellShotgunPractice = nabój (12 kaliber treningowe)
    .desc = Standardowy nabój stosowany w większości nowoczesnych strzelb. Amunicja treningowa wystrzeliwuje kredowe śrutki, które nieco kłują, ale poza tym nie powodują żadnych trwałych uszkodzeń.
ent-ShellTranquilizer = nabój (12 kaliber uspokajające)
    .desc = Standardowy nabój stosowany w większości nowoczesnych strzelb. Amunicja usypiająca zawiera pojedynczą strzykawkę balistyczną wypełnioną silnym środkiem usypiającym, który w sposób nieszkodliwy powoduje uśpienie celów.
ent-ShellShotgunImprovised = improwizowany nabój do strzelby
    .desc = Domowej roboty nabój do strzelby, który wystrzeliwuje bolesne odłamki szkła. Rozrzut jest tak szeroki, że nie trafiłby nawet w szeroką ścianę stodoły.
ent-ShellShotgunUranium = nabój (12 kaliber uranowe)
    .desc = Standardowy nabój stosowany w większości nowoczesnych strzelb. Amunicja uranowa zastępuje ołówowy rdzeń śrutu materiałem rozszczepialnym, napromieniowując cele od wewnątrz.
