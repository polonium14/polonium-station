ent-MagazineLightRifleBox = magazynek pudełkowy (.30 karabinowe)
    .desc = Pudełko zawierające 100-nabojowy pas połączonych nabojów kalibru .30 do karabinów, stosowanych w lekkich karabinach maszynowych, takich jak L6. Przeznaczone do przechowywania amunicji kinetycznej ogólnego przeznaczenia.
ent-MagazineLightRifle = magazynek (.30 karabinowe)
    .desc = Zakrzywiony, dwurzędowy magazynek na 30 nabojów do karabinów bojowych. Przeznaczony do amunicji kinetycznej ogólnego przeznaczenia.
ent-MagazineLightRifleEmpty = pusty magazynek (.30 karabinowe)
    .desc = Zakrzywiony, dwurzędowy magazynek na 30 nabojów do karabinów bojowych.
    .suffix = Puste
ent-MagazineLightRiflePractice = magazynek (.30 karabinowe treningowe)
