ent-StatueVenusRed = posąg czystej dziewicy
    .desc = Starożytny marmurowy posąg. Postać przedstawiona jest z sięgającym do podłogi warkoczem i trzyma w ręku czerwoną skrzynkę z narzędziami.
    .suffix = Czerwony
ent-StatueVenusBlue = posąg czystej dziewicy
    .desc = Starożytny marmurowy posąg. Postać ma spleciony w warkocz sięgający podłogi i trzyma w ręku niebieską skrzynkę z narzędziami.
    .suffix = Niebieski
ent-StatueBananiumClown = posąg zbawiciela bananium
    .desc = Posąg „bananium”. Przedstawia on powrót zbawiciela, który powstanie i poprowadzi klaunów ku wielkiemu honk.
ent-BaseIronsandStatue = { ent-BaseStructure }
    .desc = Tajemnicza statua znaleziona na pustyni z piasku żelaznego.
ent-StatueIronsandSmall = piasek żelazisty i mała figurka
    .desc = { ent-BaseIronsandStatue.desc }
ent-StatueIronsandSmall2 = piasek żelazisty i mała figurka
    .desc = { ent-BaseIronsandStatue.desc }
ent-StatueIronsandTall = żelazny piasek i wysoki pomnik
    .desc = { ent-BaseIronsandStatue.desc }
ent-StatueIronsandTall2 = żelazno-piaskowy wysoki posąg
    .desc = { ent-BaseIronsandStatue.desc }
