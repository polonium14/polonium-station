ent-ShelfBase = półka
    .desc = Dziwne miejsce, żeby położyć... właściwie cokolwiek. Masz wrażenie, że nie powinieneś tego widzieć.
ent-ShelfBaseReinforced = wzmocniona półka
    .desc = Wygląda tak solidnie, jak sama rzeczywistość.
ent-ShelfWood = drewniana półka
    .desc = Wygodne miejsce, żeby położyć... właściwie cokolwiek.
ent-ShelfMetal = metalowa półka
    .desc = Solidne miejsce, żeby położyć... właściwie cokolwiek.
ent-ShelfGlass = szklana półka
    .desc = Kruche miejsce, żeby położyć... właściwie cokolwiek.
ent-ShelfRWood = solidna drewniana półka
    .desc = Bezpieczne miejsce na twoją ulubioną butelkę whisky.
ent-ShelfRMetal = solidna metalowa półka
    .desc = Mocne i lśniące miejsce na przechowywanie wszystkich twoich fiolek.
ent-ShelfRGlass = solidna szklana półka
    .desc = Krystalicznie czyste, wzmocnione szklane drzwiczki pozwalają pochwalić się wszystkimi wymyślnymi butelkami, za które zdecydowanie nie sprzedałeś ulubionego ćmoczłeka współpracownika.
ent-ShelfBar = półka barowa
    .desc = Wykonana z najlepszego syntetycznego drewna, idealna do przechowywania wszelkich alkoholi.
ent-ShelfKitchen = półka kuchenna
    .desc = Pomieści noże, przyprawy i wszystko, co dobre!
ent-ShelfChemistry = półka chemiczna
    .desc = Chroni wszystkie twoje chemikalia i trzyma je z dala od niepowołanych rąk... to znaczy, publiczności!
ent-ShelfChemistryChemistrySecure = { ent-ShelfChemistry }
    .suffix = Chemia, zabezpieczone
