ent-ComputerAlert = konsola alarmów atmosferycznych
    .desc = Urządzenie wyświetlające informacje o wszystkich alarmach atmosferycznych i przeciwpożarowych na terenie stacji
ent-ComputerAtmosMonitoring = monitor sieci atmosferycznej
    .desc = Używany do monitorowania sieci atmosferycznych stacji.
ent-ComputerEmergencyShuttle = konsola wahadłowca ewakuacyjnego
    .desc = Obsługuje autoryzację wczesnego startu promu.
ent-BaseComputerShuttle = konsola wahadłowca
    .desc = Używana do pilotowania wahadłowca.
ent-ComputerShuttle = konsola wahadłowca
    .desc = Używana do pilotowania wahadłowca.
ent-ComputerShuttleSyndie = konsola wahadłowca syndykatu
    .desc = Używana do pilotowania wahadłowca syndykatu.
ent-ComputerShuttleCargo = konsola wahadłowca logistycznego
    .desc = Używana do pilotowania wahadłowca logistycznego.
ent-ComputerShuttleSalvage = konsola wahadłowca odzysku
    .desc = Używana do pilotowania wahadłowca odzysku.
ent-ComputerIFF = konsola systemu rozpoznawania
    .desc = Umożliwia kontrolę cech IFF tego statku.
ent-ComputerIFFSyndicate = konsola systemu rozpoznawania syndykatu
    .desc = Umożliwia kontrolę cech IFF i ukrycia tego statku.
    .suffix = Syndykat
ent-ComputerPowerMonitoring = konsola monitorująca zasilanie
    .desc = Monitoruje poziomy zasilania na całej stacji.
ent-ComputerMedicalRecords = konsola do rejestrów medycznych
    .desc = Służy do sprawdzania rejestrów medycznych.
ent-ComputerCriminalRecords = konsola do rejestrów kryminalnych
    .desc = Służy do sprawdzania rejestrów kryminalnych. Tylko ochrona może je modyfikować.
ent-ComputerStationRecords = konsola do rejestrów stacji
    .desc = Służy do sprawdzania rejestrów stacji.
ent-ComputerCrewMonitoring = konsola monitorowania załogi
    .desc = Służy do monitorowania aktywnych czujników zdrowia wbudowanych w większość mundurów załogi.
ent-ComputerResearchAndDevelopment = konsola rozwoju i badań
    .desc = Komputer służący do interakcji z narzędziami B+R.
ent-ComputerAnalysisConsole = konsola analizy
    .desc = Komputer służący do interakcji z analizatorem artefaktów.
ent-ComputerId = konsola kart identyfikacyjnych
    .desc = Terminal do programowania kart identyfikacyjnych pracowników Nanotrasen, umożliwiający dostęp do części stacji.
ent-ComputerBodyScanner = konsola skanera ciała
    .desc = Skaner ciała. Połącz go z stołem operacyjnym lub łóżkiem medycznym przez konfigurator sieci w celu zapoznania się z danymi na żywo pacjenta.
ent-ComputerComms = konsola komunikacyjna
    .desc = Komputer służący do ogłaszania komunikatów na stacji za pomocą klawiatury, ustawiania odpowiedniego poziomu alertu oraz wezwania promu ewakuacyjnego.
ent-SyndicateComputerComms = konsola komunikacyjna syndykatu
    .desc = Komputer zdolny do zdalnego włamania się do systemów komunikacyjnych stacji. Użycie go do ogłoszenia komunikatu powiadomi stację o twojej obecności.
ent-WizardComputerComms = konsola komunikacyjna czarodzieja
    .desc = Komputer zdolny do magicznego przekazywania twojej mowy na stację. Użycie go do ogłoszenia komunikatu powiadomi stację o twojej obecności.
ent-CentcommComputerComms = konsola komunikacyjna centralnego dowództwa
    .desc = Komputer służący do ogłaszania komunikatów na całym świecie za pomocą klawiatury. Lepszy kuzyn zwykłego komputera komunikacyjnego.
ent-ComputerSolarControl = konsola do kontroli paneli słonecznych
    .desc = Kontroler do paneli słonecznych.
ent-ComputerRadar = konsola skanera masy
    .desc = Komputer do wykrywania pobliskich obiektów, wyświetlający je według pozycji i masy.
ent-ComputerCargoOrders = konsola zamówień logistycznych
    .desc = Służy do zamawiania zapasów i zatwierdzania próśb.
ent-ComputerCargoOrdersEngineering = konsola zamówień działu inżynieryjnego
    .desc = Służy do zamawiania zapasów przez dział inżynieryjny.
ent-ComputerCargoOrdersMedical = konsola zamówień działu medycznego
    .desc = Służy do zamawiania zapasów przez dział medyczny.
ent-ComputerCargoOrdersScience = konsola zamówień działu badań
    .desc = Służy do zamawiania zapasów przez dział badań.
ent-ComputerCargoOrdersSecurity = konsola zamówień działu ochrony
    .desc = Służy do zamawiania zapasów przez dział ochrony.
ent-ComputerCargoOrdersService = konsola zamówień działu serwisowego
    .desc = Używany przez dział serwisowy do zamawiania materiałów eksploatacyjnych.
ent-ComputerCargoBounty = konsola nagród logistycznych
    .desc = Służy do zarządzania aktualnie aktywnymi nagrodami.
ent-ComputerFundingAllocation = konsola do alokacji funduszy
    .desc = Terminal do kontrolowania dystrybucji funduszy i wynagrodzeń dla działów.
ent-ComputerCloningConsole = konsola klonowania
    .desc = Główne urządzenie systemu klonowania, największe osiągnięcie medycyny. Posiada wiele portów i przewodów.
ent-ComputerSalvageJobBoard = tablica zleceń odzysku
    .desc = Konsola do uzyskania dostępu do ofert pracy odzysku, jeśli jesteś wystarczająco mocny.
ent-ComputerSalvageExpedition = konsola ekspedycji odzyskowych
    .desc = Służy do przyjmowania misji ratunkowych, jeśli jesteś wystarczająco wytrzymały.
ent-ComputerSurveillanceCameraMonitor = monitor kamer
    .desc = Monitor kamer nadzoru. Obserwujesz je. Może.
ent-ComputerSurveillanceWirelessCameraMonitor = monitor kamer bezprzewodowych
    .desc = Monitor bezprzewodowych kamer nadzoru. Obserwujesz je. Może.
ent-ComputerSurveillanceWirelessXenoborgCameraMonitor = monitor kamer ksenoborgów
    .desc = Bezprzewodowy monitor kamer ksenoborgów. Obserwujesz je. Chyba.
ent-ComputerPalletConsole = konsola sprzedaży ładunków
    .desc = Służy do sprzedaży towarów załadowanych na palety ładunkowe.
ent-ComputerMassMedia = konsola zarządzania mediami
    .desc = Napisz swoją wiadomość do świata!
ent-ComputerSensorMonitoring = konsola monitorowania sensorów
    .desc = Elastyczna konsola do monitorowania wszelkiego rodzaju sensorów.
    .suffix = TESTING, NIE MAPOWAĆ
ent-ComputerRoboticsControl = konsola do kontroli robotyki
    .desc = Służy do zdalnego monitorowania, wyłączania i niszczenia cyborgów na stacji.
ent-ComputerXenoborgsControl = konsola sterowania ksenoborgów
    .desc = Używane do zdalnego monitorowania wszystkich ksenoborgów.
ent-StationAiUploadComputer = konsola do przesyłania SI
    .desc = Służy do aktualizacji praw sztucznej inteligencji stacji.
ent-StationAiFixerComputer = konsola przywracania SI
    .desc = Używane do naprawy uszkodzonych sztucznych inteligencji.
ent-ComputerNukieDelivery = konsola dostawy syndykatu
    .desc =
        Komputer umożliwiający korzystanie z funkcji „bluespace” w niektórych urządzeniach przeznaczonych do operacji jądrowych. 
        Płytka drukowana jest zintegrowana z obudową i nie można jej odzyskać w przypadku demontażu urządzenia.
ent-ComputerStationTeleportersControl = konsola sterowania teleporterami stacji
    .desc = Służy do monitorowania pracy systemu teleportacji stacji.
ent-ComputerStationTeleportersControlFilled = { ent-ComputerStationTeleportersControl }
    .suffix = Automatycznie wypełnione, Sieć Nanotrasen
    .desc = { ent-ComputerStationTeleportersControl.desc }
ent-ComputerSyndicateTeleportersControl = konsola sterowania teleporterami Syndykatu
    .desc = { ent-ComputerStationTeleportersControl.desc }
