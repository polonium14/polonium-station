ent-ShuttleGunBase = działko wahaguwnowca
    .desc = { ent-BaseStructure.desc }
ent-ShuttleGunSvalinnMachineGun = LSE-400c "karabin maszynowy Svalinn"
    .desc = Podstawowa stacjonarna jednostka laserowa. Skuteczna przeciwko żywym celom oraz elektronice. Zasilany jest zwykłymi bateriami i posiada wysoką szybkostrzelność.
ent-ShuttleGunPerforator = LSE-1200c "Przebijacz"
    .desc = Zaawansowana stacjonarna jednostka laserowa. Unicestwia elektronike i jest niesamowicie groźna dla zdrowia! używa klatek mocy do strzelania.
ent-ShuttleGunFriendship = EXP-320g "Przyjaźń"
    .desc = Mała stacjonarna wyrzutnia granatów. Mieści 2 granaty.
ent-ShuttleGunDuster = EXP-2100g "Miotła"
    .desc = Potężny stacjonarny granatnik. wymaga kartridży na granaty.
ent-ShuttleGunPirateCannon = armata statku pirackiego
    .desc = Kaboom!
ent-ShuttleGunKinetic = PTK-800 "Dematerializator"
    .desc = Stacjonarne działo odzyskowe. Ładuje się samoistnie, doskonałe do wydobywania asteroid.
ent-ShuttleGunKineticOld = eksomorficzny dematerializator
    .desc = Starożytne działko, stosujące biomechaniczne systemy do przechowywania i uwalniania energi. Chociaż unikalny w swojej konstrukcji to wyszedł z użytku z uwagi na to że mechaniczne systemy są znacznie skuteczniejsze.
