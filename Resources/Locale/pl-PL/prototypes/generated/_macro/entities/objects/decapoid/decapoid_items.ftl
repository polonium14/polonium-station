ent-DecapoidClawItem = szpon dekapoida
    .desc = Duży szpon. Niezbyt nadaje się do precyzyjnych czynności, ale jest bardzo silny i bardzo ostry.
    .suffix = Nieusuwalny
ent-DecapoidBreathingApparatus = waporyzator
    .desc = Noszony na szyi aparat oddechowy dla dekapoidów. Nawilża skrzela, jeśli je masz. Działa też jako tłumacz myśli na głos.
ent-DecapoidBreathingApparatusClown = waporyzator klauna
    .desc = Noszony na szyi aparat oddechowy dla dekapoidów. Nawilża skrzela, jeśli je masz. Działa też jako tłumacz myśli na głos. Ten został zmodyfikowany przez klauna, by pasował do jego stroju...
ent-DecapoidBreathingApparatusMime = waporyzator mima
    .desc = Noszony na szyi aparat oddechowy dla dekapoidów. Nawilża skrzela, jeśli je masz. Działa też jako tłumacz myśli na głos. Ten został zmodyfikowany przez mima, by pasował do jego stroju...
ent-DecapoidVaporTank = zbiornik pary
    .desc = Obca konstrukcja złożona z dwóch zbiorników. Mniejszy pobiera wodę i zamienia ją w parę, która jest magazynowana w większym. Mieści 5 L gazu i 30u płynu.
ent-DecapoidVaporTankFilled = zbiornik pary
    .suffix = Wypełnione
    .desc = { ent-DecapoidVaporTank.desc }
