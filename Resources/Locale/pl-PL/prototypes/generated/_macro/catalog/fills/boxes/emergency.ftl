ent-BoxSurvivalAquatic = zestaw przetrwania H2O
    .desc = Pudełko z maską oddechową, butelką wody, pigułką awaryjną, flarą i nutribriciem. Standardowe wyposażenie dla wodooddechowej załogi.
    .suffix = Standardowe H2O
ent-BoxSurvivalEngineeringAquatic = zestaw przetrwania H2O o zwiększonej pojemności
    .desc = Pudełko z maską oddechową, butelką wody o zwiększonej pojemności, pigułką awaryjną, flarą i nutribriciem. Wydawane wodooddechowej załodze, której obowiązki często zmuszają do pracy w miejscach bez atmosfery.
    .suffix = Rozszerzony, H2O
ent-BoxHugAquatic = pudełko uścisków
    .desc = Pudełko dla wrażliwych ludzi, wyposażone w zestaw przetrwania dla gatunków wodnych.
    .suffix = Awaryjne H2O
ent-BoxMimeAquatic = zestaw przetrwania H2O
    .desc = Pudełko z maską oddechową, butelką wody, pigułką awaryjną, flarą i nutri-bâtardem. Standardowe wyposażenie dla wodooddechowej załogi.
    .suffix = Mim, awaryjne H2O
ent-BoxSurvivalMedicalAquatic = medyczny zestaw przetrwania H2O
    .desc = Pudełko z maską medyczną, butelką wody, pigułką awaryjną, flarą i nutribriciem. Wydawane wodooddechowej załodze medycznej.
    .suffix = Medyczny, H2O
ent-BoxSurvivalSecurityAquatic = zestaw przetrwania H2O dla ochrony
    .desc = Pudełko z maską gazową ochrony, butelką wody, pigułką awaryjną, flarą i nutribriciem. Wydawane wodooddechowej załodze ochrony.
    .suffix = Ochrona, H2O
ent-BoxSurvivalSyndicateAquatic = syndykatowy zestaw przetrwania H2O
    .desc = Syndykatowe pudełko przetrwania z maską gazową syndykatu, butelką wody o zwiększonej pojemności, pigułką awaryjną, flarą i odrobiną żywności.
    .suffix = Syndykat, H2O
