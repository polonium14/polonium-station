ent-ActionChangelingBiodegrade = Biodegradacja
    .desc = Zwymiotuj kwasem na swoje więzy i uwolnij się.
ent-ActionChangelingDevour = [color=red]Pożarcie[/color]
    .desc = Pochłoń esencję ofiar i wchłoń ich tożsamość oraz umysł do własnego.
ent-ActionChangelingTransform = Transformacja
    .desc = Przemień się i przyjmij tożsamość osób, które pochłonąłeś.
ent-ActionChangelingStore = Sklep DNA
    .desc = Otwiera sklep ze zdolnościami.
ent-ActionChangelingVoiceMimic = Naśladowanie głosu
    .desc = Ukształtuj struny głosowe, by naśladować czyjś głos.
ent-ActionChangelingStingDna = Pobranie DNA
    .desc = Po cichu wchłoń tożsamość niczego niepodejrzewających ofiar. Nie dodaje DNA do sklepu ani nie zalicza postępu celu.
ent-BaseActionChangelingSting = { ent-BaseAction }
    .desc = { ent-BaseAction.desc }
ent-ActionChangelingStingBlind = Oślepiające żądło
    .desc = Po cichu użądl cel i pogorsz jego wzrok na krótki czas.
ent-ActionChangelingStingCryogenic = Kriogeniczne żądło
    .desc = Po cichu użądl cel i drastycznie spowolnij jego ruchy.
ent-ActionChangelingStingLead = Śmiertelne żądło
    .desc = Po cichu użądl cel i wstrzyknij mu śmiertelną dawkę wolno działającej trucizny.
ent-ActionChangelingLastResort = [color=red]Ostatnia deska ratunku[/color]
    .desc = Poświęcamy nasze obecne ciało w chwili potrzeby, gwałtownie rozrastając się, by przebić przeszkody, i odradzamy się jako larwa głowowa.
ent-ActionChangelingTakeOverCorpse = Przejęcie zwłok
    .desc = Zainfekuj zwłoki, by powrócić do prawdziwej formy.
ent-ActionChangelingNightVision = Przełącz noktowizję
    .desc = Włącza lub wyłącza nasze widzenie w ciemności.
ent-ActionChangelingScreech = Wrzask
    .desc = Wydajemy ogłuszający wrzask, który osłabia otaczających nas.
ent-ActionChangelingFakeMindshieldToggle = [color=green]Przełącz fałszywą tarczę umysłu[/color]
    .desc = Włącz lub wyłącz widoczność naszej tarczy umysłu.
ent-ActionChangelingStasis = [color=red]Wejdź w stazę[/color]
    .desc = Wejdź w regeneracyjną stazę, udając śmierć, aby zregenerować wszystkie obrażenia.
ent-ActionChangelingStasisWeak = { ent-ActionChangelingStasis }
    .desc = { ent-ActionChangelingStasis.desc }
ent-ActionChangelingStingMute =
    Żądło wyciszające
    Po cichu użądl cel i wstrzyknij mu substancje, które uniemożliwiają mówienie.
    Wymaga 30 chemikaliów.
    .desc =
        Silently sting a target and inject them with chemicals that prevent them from speaking. 
        
        Requires 30 Chemicals.
ent-ActionChangelingFleshtomb = Fleshtomb
    .desc =
        Preserve a body in a fragile cocoon made of flesh, which slowly harvests their life for DNA. 
        
        Requires 35 Chemicals.
ent-ActionChangelingStingArmblade = Armblade Sting
    .desc =
        Silently sting a target and cause them to grow a dull armblade after a lengthy delay. 
        
        Requires 50 Chemicals.
ent-ActionChangelingStingHemotoxin = Hemotoxin Sting
    .desc =
        Sting a target and inject them with a dangerous dose of various toxins, causing extensive bleeding. 
        
        Requires 30 Chemicals.
ent-ActionRetractableItemArmblade = Ostrze w ramieniu
    .desc = Zrzuć swoje ciało i przekształć je w mięsiste ostrze.
