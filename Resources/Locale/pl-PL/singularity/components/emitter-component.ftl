### EmitterComponent

# Shows when attempting to turn the emitter on or off without proper access
comp-emitter-access-locked = Dostęp do { $target } jest zablokowany!
# Shows when turning the emitter on/off
comp-emitter-turned-on = { CAPITALIZE($target) } włącza się.
comp-emitter-turned-off = { CAPITALIZE($target) } wyłącza się.
# Shows if the user attempts to activate the emitter while it's un-anchored.
comp-emitter-not-anchored = { CAPITALIZE($target) } nie jest zakotwiczony na ziemi!
emitter-component-current-type = The current selected type is: { $type }.
emitter-component-type-set = Ustawiono typ na: { $type }
emitter-destroyed-broadcast = Zniszczono emiter zasilany { $location }.
emitter-unlocked-broadcast = Odblokowano emiter zasilany { $location }.
emitter-unpowered-broadcast = Zasilany emiter { $location } stracił moc.
emitter-turn-off-broadcast = Wyłączono emiter zasilany { $location }.
