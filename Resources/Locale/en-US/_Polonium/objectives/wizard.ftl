wizard-objective-kill-title = Slay {$targetName}, {CAPITALIZE($job)}.
wizard-objective-cluwne-title = Curse {$targetName}, {CAPITALIZE($job)}, with Cluwne's Curse.
wizard-objective-polymorph-title = Turn {$targetName}, {CAPITALIZE($job)}, into an animal.
wizard-objective-chosen-one-title = The Federation's Chosen One: keep {$targetName}, {CAPITALIZE($job)}, alive until the end of the shift.

wizard-objective-cluwne-count-title =
    Curse {$count} {$count ->
        [one] person
       *[other] people
    } with Cluwne's Curse.
wizard-objective-polymorph-count-title =
    Turn {$count} {$count ->
        [one] person
       *[other] people
    } into animals.
wizard-objective-slippery-count-title =
    Cast Slippery Slope on {$count} {$count ->
        [one] person
       *[other] people
    }.
wizard-objective-animate-count-title = Bring at least {$count} objects on the station to life.
wizard-objective-door-count-title = Turn at least {$count} walls or airlocks into wooden doors.

wizard-objective-steal-title = A treasure for the Federation: {$itemName}.
wizard-objective-steal-multiply-description = The Federation's vault needs more of these. Have at least {$count} on you at the end of the shift.
wizard-objective-familiar-title = A familiar: {$itemName}.
wizard-objective-familiar-description = Every self-respecting wizard has a familiar, and {$itemName} will do nicely. At the end of the shift it must be alive and with you.

wizard-objective-steal-xeno-artifact-description = The alien artifact pulses with an energy Nanotrasen scientists don't understand. The archmages do. Be dragging it along at the end of the shift.
wizard-objective-steal-bible-description = The chaplain's holy book is a potent magical focus in the wrong hands. Yours, that is. Have it on you at the end of the shift.
wizard-objective-steal-captain-sword-description = The captain's sabre is a fine piece of steel, and it will look even better in the Federation's vault. Have it on you at the end of the shift.
wizard-objective-steal-hand-teleporter-description = The hand teleporter is Nanotrasen's crude techno-magic. The archmages want to see how it works inside. Have it on you at the end of the shift.
wizard-objective-steal-antique-laser-description = The captain's antique laser pistol is supposedly a family heirloom. From now on it's a Federation heirloom. Have it on you at the end of the shift.
wizard-objective-steal-plant-rd-description = The research director's potted plant is no ordinary plant, or so the Federation's alchemists claim. Have it on you or drag it along at the end of the shift.
wizard-objective-steal-altar-description = The Nanotrasen altar gathers the faith of the whole crew, and the Federation would gladly take that power. Be dragging it along at the end of the shift.
wizard-objective-steal-booze-dispenser-description = Even archmages need a potion after a long day, and the bar's booze dispenser will do just fine. Be dragging it along at the end of the shift.
wizard-objective-steal-chem-dispenser-description = A chemical dispenser is practically an alchemist's cauldron. The Federation needs it to brew potions. Be dragging it along at the end of the shift.
wizard-objective-steal-gold-medal-description = The crewmember's gold medal shines bright enough to adorn an archmage's robe. Have it on you at the end of the shift.
wizard-objective-steal-warden-hat-description = The warden's cap is a trophy to boast about in the Wizard Tower for years. Have it on you at the end of the shift.
wizard-objective-steal-detective-lighter-description = The detective's engraved lighter hides a spark of true fire. The Federation will take good care of it. Have it on you at the end of the shift.
wizard-objective-steal-head-cloak-description = A wizard has to look good, and a head of staff's cloak will make a fine new robe. Have it on you at the end of the shift.
wizard-objective-steal-head-cloaks-description = A wizard has to look good, and the heads of staff's cloaks will make fine new robes. Have at least {$count} on you at the end of the shift.
wizard-objective-steal-stamp-description = A stamp is a seal of power over this station's paperwork. Have it on you at the end of the shift.
wizard-objective-steal-stamps-description = Stamps are seals of power, each one rules over this station's paperwork. Have at least {$count} on you at the end of the shift.
wizard-objective-steal-tech-disk-description = A technology disk is a scroll of Nanotrasen knowledge the Federation's librarians would love to study. Have it on you at the end of the shift.
wizard-objective-steal-tech-disks-description = Technology disks are scrolls of Nanotrasen knowledge the Federation's librarians would love to study. Have at least {$count} on you at the end of the shift.
