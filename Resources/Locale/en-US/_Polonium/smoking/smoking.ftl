smokable-out-of-oxygen = {CAPITALIZE(THE($smokable))} goes out for lack of air.

smokable-verb-light = Light cigarette
smokable-light-other = {CAPITALIZE(THE($user))} holds out {THE($lighter)} and lights {THE($target)}'s cigarette.

smokable-verb-stomp = Stomp out
smokable-stomp = {CAPITALIZE(THE($user))} calmly treads on {THE($smokable)}, putting it out.

smokable-blow-unlit = Light it first.
smokable-blow-1 = {CAPITALIZE(THE($user))} exhales a large cloud of smoke.
smokable-blow-2 = {CAPITALIZE(THE($user))} blows some smoke rings.
smokable-blow-3 = {CAPITALIZE(THE($user))} exhales smoke through the nose.
smokable-blow-4 = {CAPITALIZE(THE($user))} takes a long drag and puffs out a cloud.
smokable-blow-face = {CAPITALIZE(THE($user))} blows smoke right into {THE($target)}'s face!

trait-smoker-name = Smoker
trait-smoker-desc = Years of smoking left your lungs scarred for good, only a transplant helps. Go too long without a smoke and the withdrawal kicks in.

smoker-relief = Ah, that's better.
smoker-withdrawal-1 = You could really go for a smoke right about now.
smoker-withdrawal-2 = Your hands won't stop shaking. You need a cigarette.
smoker-withdrawal-3 = You can't think of anything but a cigarette.
smoker-craving-1 = You crave a cigarette.
smoker-craving-2 = You pat your pockets for a smoke.
smoker-craving-3 = The thought of a cigarette won't leave you alone.
