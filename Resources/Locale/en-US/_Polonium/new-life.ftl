ghost-gui-new-life-button-countdown = Return to lobby ({ $time })

new-life-window-title = New life
new-life-window-intro = Your character has died. You may return to the lobby and join the ongoing round as a [bold]completely new character[/bold].
new-life-window-rules-title = New life rules
new-life-window-rule-1 = You must pick an [bold]entirely new character[/bold].
new-life-window-rule-2 = Your new character [bold]remembers nothing[/bold] about the previous one or about what happened this round: who killed you, what you saw as a ghost, who the antagonists are.
new-life-window-rule-3 = You may not use that knowledge in any way.
new-life-window-rule-4 = Once you return to the lobby, you [bold]will not be able to go back[/bold] to your old body.
new-life-window-footer = New lives left this round: { $count }
new-life-window-footer-unlimited = New lives are not limited this round
new-life-window-cancel = Cancel
new-life-window-confirm = Return to lobby

new-life-same-character-title = Same character
new-life-same-character-header = Character not changed
new-life-same-character-text =
    You already played [bold]{ $name }[/bold] this round before returning to the lobby.

    Are you sure you want to continue?
new-life-same-character-cancel = Change character
new-life-same-character-continue = Continue

cmd-togglenewlife-desc = Enables or disables returning to the lobby after death to join as a new character.
cmd-togglenewlife-help = Usage: togglenewlife [true/false]
cmd-togglenewlife-arg-enabled = <enabled>
cmd-togglenewlife-enabled = New life has been enabled.
cmd-togglenewlife-disabled = New life has been disabled.
