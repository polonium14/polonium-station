ghost-role-information-morph-name = Morph
ghost-role-information-morph-description = You are a morph, an abomination of science created primarily with changeling cells. You may take the form of nearby objects, which will alert any nearby observers. While disguised you move faster but deal less damage, and anyone examining you up close will note an uncanny wrongness. Eat items and dead or unconscious creatures, digesting creatures restores your health. Whoever touches you while disguised will be bitten and poisoned.

morph-devour-disguised = You can not eat anything while you are disguised!
morph-disguise-invalid = You can't assume that form.
morph-disguise-cooldown = Your chameleon skin is still repairing itself!
morph-disguise-self = You twist your body and assume the form of {THE($target)}.
morph-disguise-others = {CAPITALIZE(THE($morph))} suddenly twists and changes shape, becoming a copy of {THE($target)}!
morph-disguise-examine = [color=red]It doesn't look quite right...[/color]
morph-reveal-already = You're already in your normal form!
morph-reveal-self = You reform to your normal body.
morph-reveal-others = {CAPITALIZE(THE($morph))} suddenly collapses in on itself, dissolving into a pile of green flesh!
morph-death-disguised = {CAPITALIZE(THE($morph))} twists and dissolves into a pile of green flesh!
morph-ambush-victim = {CAPITALIZE(THE($morph))} bites you!
morph-ambush-others = {CAPITALIZE(THE($morph))} violently bites {THE($victim)}!

morph-spit-nothing = You have nothing prepared to spit.
morph-spit-throw = {CAPITALIZE(THE($morph))} spits {THE($item)}!
morph-spit-drop = {CAPITALIZE(THE($morph))} spits {THE($item)} out!
morph-throw-prepared = You prepare to spit {THE($item)}.
morph-digest-start = You begin digesting {THE($target)}.
morph-digest-fail = {CAPITALIZE(THE($target))} cannot be digested.
morph-digest-item = You digest {THE($target)}.
morph-digest-mob = You digest {THE($target)}, restoring some health.

morph-stomach-entity = {CAPITALIZE($entity)}
morph-stomach-entity-prepared = {CAPITALIZE($entity)} (prepared to spit)
morph-stomach-drop = Spit out
morph-stomach-throw = Prepare to spit
morph-stomach-digest = Digest

reagent-name-morph-venom = morph venom
reagent-desc-morph-venom = Deadly venom of a shapeshifting creature.
