cmd-roundendtext-desc = Opens the window for setting the round outcome shown in the round end summary.
cmd-roundendtext-help = Usage: roundendtext
cmd-roundendtext-server = This command cannot be used from the server console.

admin-round-end-text-window-title = Round outcome
admin-round-end-text-notice = Every player sees this text at the top of the round end summary. It must not be used for jokes or similar texts, and it has to be written carefully and correctly. Describe the outcome of the round without mentioning specific players. The text complements the automatic summary below it and must not contradict it.
admin-round-end-text-rules-title = Automatic summary
admin-round-end-text-rules = Below the outcome, these rules of this round add their own text: { $rules }
admin-round-end-text-rules-none = No rule of this round adds its own text to the summary.
admin-round-end-text-status-editable = Saving an empty text removes the outcome from the summary.
admin-round-end-text-status-locked = The outcome can only be changed while the round is in progress.
admin-round-end-text-text = Text
admin-round-end-text-placeholder = E.g. The crew evacuated the station after the reactor failure.
admin-round-end-text-preview = Preview
admin-round-end-text-preview-empty = The summary will show no outcome.
admin-round-end-text-never-edited = Nobody has set the outcome this round.
admin-round-end-text-last-edit = Last changed by { $admin } at { $time } into the round.
admin-round-end-text-save = Save
admin-round-end-text-too-long = The text is too long, the limit is { $max } characters.
admin-round-end-text-invalid-markup = Invalid markup: { $error }
admin-round-end-text-tag-not-allowed = The { $tag } tag is not allowed. Allowed tags: bold, italic, bolditalic, color, head, bullet.
admin-round-end-text-header = [head=3]Round outcome[/head]
