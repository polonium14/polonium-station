ent-BaseModSuitCore = { ent-BaseItem }
    .desc = { ent-BaseItem.desc }
ent-ModSuitCoreStandard = R.I.G. core
    .desc = The heart of a R.I.G. Used in its construction. It can be upgraded with plasma or an anomaly core.
ent-ModSuitCoreUnsecured = unsecured R.I.G. core
    .desc = A R.I.G. core with an upgrade inside that still has to be screwed in.
ent-ModSuitCorePlasma = plasma R.I.G. core
    .desc = A R.I.G. core that turns plasma sheets into charge for the suit's power cell.
ent-ModSuitCoreElectric = electric R.I.G. core
    .desc = A R.I.G. core built around the core of an electric anomaly. It slowly recharges the suit's power cell.
ent-ModSuitCoreBluespace = bluespace R.I.G. core
    .desc = A R.I.G. core built around the core of a bluespace anomaly. The suit can hold more complex modules.
ent-ModSuitCoreGravity = gravitational R.I.G. core
    .desc = A R.I.G. core built around the core of a gravity anomaly. The suit weighs its wearer down less.
ent-ModSuitCoreCivilian = civilian R.I.G. core
    .desc = A simpler R.I.G. core that needs no uranium. It only fits a civilian R.I.G.
ent-ModSuitConstructionShell = R.I.G. shell
    .desc = The groundwork for a R.I.G.
