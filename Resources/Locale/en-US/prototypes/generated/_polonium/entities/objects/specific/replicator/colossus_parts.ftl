ent-BaseReplicatorColossusPart = { ent-BaseItem }
    .desc = { ent-BaseItem.desc }
ent-ReplicatorColossusPartHull = colossus hull
    .desc = The armoured belly of a Colossal Replicator. Every other part is bolted onto it.
ent-ReplicatorColossusPartDrive = colossus drive
    .desc = A nanite-wound actuator block that turns the hull's power into the stride of six legs.
ent-ReplicatorColossusPartLeg = colossus leg
    .desc = A jointed leg as tall as a person, tipped with a claw that grips the deck plating.
ent-ReplicatorColossusPartHead = colossus head
    .desc = A flat sensor dish with a dark visor. It still tracks movement even with nothing to power it.
ent-ReplicatorColossusPartFieldGenerator = colossus field generator
    .desc = A bluespace coil that bends space around the colossus and throws intruders far away.
ent-ReplicatorColossusPartMinigun = colossus photon minigun
    .desc = A rotary emitter that spits out bolts of light faster than the eye can follow.
ent-ReplicatorColossusPartPhotonLaser = colossus photon lasers
    .desc = Shoulder-mounted laser pods that sweep nanites across walls and floors.
ent-ReplicatorColossusPartTentacles = colossus tentacles
    .desc = A bundle of segmented cables that trail behind the colossus and feed matter into it.
ent-ReplicatorColossusPartCore = colossus core
    .desc = A caged crystal of seething magenta light. Once it is seated in the hull, the colossus only needs a mind.
ent-ReplicatorColossusCoreSalvage = burnt-out colossus core
    .desc = The core of a Colossal Replicator, cut out of its wreck. The nanites in it are dead, but the lattice they left behind still shows how they tracked their prey.
