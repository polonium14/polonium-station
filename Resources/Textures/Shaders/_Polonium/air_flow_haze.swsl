uniform sampler2D SCREEN_TEXTURE;
uniform sampler2D NOISE_TEXTURE;

const highp float SPATIAL_SCALE = 2.0;
const highp float DISTORTION = 0.011;
const highp float WISP_GAIN = 0.5;
const highp float WISP_GLOW = 0.1;

void fragment()
{
    highp float strength = texture2D(TEXTURE, UV).r;
    strength = clamp(-strength * strength + 2.0 * strength, 0.0, 1.0);

    highp vec2 scroll1 = vec2(TIME * 0.31, TIME * 0.23);
    highp vec2 scroll2 = vec2(TIME * -0.19, TIME * 0.37);
    highp float noise1 = texture2D(NOISE_TEXTURE, fract(UV * SPATIAL_SCALE - scroll1)).r;
    highp float noise2 = texture2D(NOISE_TEXTURE, fract(UV * SPATIAL_SCALE - scroll2 + vec2(0.43, 0.12))).r;

    highp vec2 distortion = vec2(noise1 - 0.5, noise2 - 0.5);
    highp vec4 color = zTextureSpec(SCREEN_TEXTURE, UV + distortion * DISTORTION * strength);

    // Pale shreds of air. They only brighten what is already lit, so nothing shows through the dark.
    highp float wisp = clamp((noise1 + noise2 - 1.0) * 2.5, 0.0, 1.0) * strength;
    highp float lit = smoothstep(0.0, 0.05, max(color.r, max(color.g, color.b)));

    COLOR = vec4(color.rgb * (1.0 + wisp * WISP_GAIN) + vec3(wisp * WISP_GLOW * lit), color.a);
}
